importlib kernel32,\
	VirtualProtect

macro Hook.hookAPI_static func, const_hook{
	local ..start, ..end, loword, hiword, hook_result
	virtual at 0
		..start:
		mov pax, const_hook
		jmp pax
		..end:
		align pointer.size * 2
		load loword pointer from ..start
		load hiword pointer from ..start + pointer.size
	end virtual
	procbuf_alloc hook_result, pointer.size
	$call [VirtualProtect](func, pointer.size * 2, PAGE_EXECUTE_READWRITE, addr hook_result)
	mov pax, func
	mov pdx, loword
	mov pointer[pax], pdx
	mov pdx, hiword
	mov pointer[pax + pointer.size], pdx
	procbuf_free hook_result
}


macro Hook.captureAPI_static func, const_hook, bytesDest, bytesReserved{
	local ..start, ..end, loword, hiword, hook_result
	virtual at 0
		..start:
		mov pax, pointer const_hook
		; align 10
		jmp pax
		..end:
		align (pointer.size * 2)
		load loword pointer from ..start
		load hiword pointer from ..start + pointer.size
	end virtual
	procbuf_alloc hook_result, pointer.size
	$call [VirtualProtect](func, bytesReserved, PAGE_EXECUTE_READWRITE, addr hook_result)
	mov pax, func
	lea pcx, [pax + bytesReserved]
	push psi pdi pcx
	mov psi, pax
	mov pdi, bytesDest
	mov ecx, bytesReserved
	rep movsb
	mov pdx, loword
	mov pointer[pdi], pdx
	mov pointer[pax], pdx
	mov pdx, hiword
	mov pointer[pdi + pointer.size], pdx
	mov pointer[pax + pointer.size], pdx
	pop pcx
	mov pointer[pdi + pointer.size / 4], pcx
	pop pdi psi
	procbuf_free hook_result
}

