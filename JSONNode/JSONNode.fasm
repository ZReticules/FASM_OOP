.proc_frame_mode_static

struct JSONIterContext
	union
		struct 				; arrays, doubles, objects
			union
				struct  	; doubles
					result 	ParsedDouble
					negExp	rd 1
				ends
				struct  	; arrays and objects
					lpRoot	rptr 1
					lpKey 	rptr 1
					keyLen	rd 1
					keyEsc	rd 1
				ends
			ends
			state 	rd 1
		ends
		struct 				; booleans
			cmpstr 	rptr 1
		ends
		struct 				; strings
			strEnd 	rptr 1
			escaped	rd 1
		ends
	ends
	pUtf8Len	rptr 1
	end 		rptr 1
ends

JSONIterNumCtxState enum \
	integer,\
	dot,\
	order,\
	fractal,\
	e,\
	exp

JSONIterArrCtxState enum \
	noСomma,\
	comma

JSONIterObjCtxState enum \
	noСomma,\
	comma,\
	keyOpened,\
	keyClosed,\
	colon


.proc cdecl JSONNode.make(.pthis, .type, .value:QWORD, .len, .isConst:DWORD) uses pbx
	virtObj .this JSONNode at pbx from @arg1
	
	@sarg @arg4	
	@larg pdx, @arg2, xmm0, @arg3, pax, @arg4

	; int3
	and edx, 0x7
	mov [.this.jType], dl
	jmp [.type_handlers + edx * pointer.size]
	.return: ret

	.type_handlers dptr .number,\ 
		.string,\ 
		.bool,\ 
		.array,\ 
		.object,\
		.null,\
		.parse_string,\
		.integer,\
		.unknown

	.bool:
	.number:
	.null:
	.integer:
		movq [.this.value], xmm0
		ret

	.string:
		.local .s_psi:POINTER
		mov [.s_psi], psi
		movptr psi, xmm0
		mov [.this.lpStr], psi
		mov [.this.len], eax
		cmp eax, -1
		jne @f
			$call [.this.len] = CNV|strlen(psi)
		@@:
		mov eax, [.isConst]
		test eax, eax
		setnz al
		mov [.this.isConst], al
			cmovz psi, [.s_psi]
			jz .return
		$call [.this.lpStr] = CNV|alloc([.this.len])
		$call CNV|fill([.this.lpStr], psi, [.this.len])
		mov psi, [.s_psi]
		ret

	.object:
		$call [.this.subNodes] = CNV|alloc(sizeof.SimpleDict)
		$call [.this.subNodes]::make([.len])
		mov [.this.selectedNode], NULL
		ret

	.array:
		imul eax, eax, sizeof.JSONNode
		$call CNV|alloc(addr 4 + 4 + eax)
		mov [.this.subNodes], pax
		mov [.this.selectedNode], NULL
		mov pdx, [.len]
		mov [pax + JSONFlatArray.capacity], edx
		mov [pax + JSONFlatArray.len], 0
		ret

	.unknown:
		mov [.this.jType], -1
		ret

	.parse_string:
		.local .resultLen:DWORD

		mov [.resultLen], 0
		$call .this::__from_string(pointer xmm0, &.resultLen)
		ret
.endp

.proc cdecl JSONNode.__from_string(.pthis, .lpString, .lpLen) uses pbx psi
	@sarg @arg3	
	virtObj .this JSONNode at pbx from @arg1
	@larg psi, @arg2
	@larg pax, @arg3
	
	.local .ctx:JSONIterContext

	mov [.ctx.pUtf8Len], pax
	movzx eax, byte[psi]
	switch eax
		case 'n'
			mov [.this.jType], JSONTypes.NULL
			mov [.ctx.cmpstr], .null_c
			$call Utf8|iterate(psi, -1, .utf8_callback_null, &.ctx)
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			jmp end_case
		case 't', 'f'
			mov [.this.jType], JSONTypes.BOOL
			sub eax, 'f'
			test eax, eax
			setnz al
			and eax, 0xFF
			mov dword[.this.value], eax
			mov pax, [.consts + pax * pointer.size]
			mov [.ctx.cmpstr], pax
			$call Utf8|iterate(psi, -1, .utf8_callback_bool, &.ctx)
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			jmp end_case
		case +'0' ... +'9', '-'
			mov [.this.jType], JSONTypes.NUMBER
			mov [.ctx.result.sign], 0
			cmp eax, '-'
			mov pdx, [.lpLen]
			jne @f
				mov [.ctx.result.sign], 1
				inc psi
				inc dword[pdx]
			@@:
			mov [.ctx.state], JSONIterNumCtxState.integer
			pxor xmm0, xmm0
			movq [.ctx.result.intVal], xmm0
			movq [.ctx.result.fracVal], xmm0
			movd [.ctx.result.order], xmm0
			mov [.ctx.result.expVal], 0
			mov [.ctx.negExp], 0
			$call Utf8|iterate(psi, -1, .utf8_callback_number, &.ctx)
			cmp [.ctx.negExp], 0
			je @f
				neg [.ctx.result.expVal]
			@@:
			movzx pax, [.ctx.result.sign]
			sub psi, pax
			switch [.ctx.state]
				case_default
					$call .ctx.result::getDouble()
					cmp [.ctx.result.sign], 0
						je end_case
					pcmpeqq xmm1, xmm1
					psllq xmm1, 63
					por xmm0, xmm1
					jmp end_case
				case JSONIterNumCtxState.integer
					mov [.this.jType], JSONTypes.INTEGER
					movq xmm0, [.ctx.result.intVal]
					cmp [.ctx.result.sign], 0
						je end_case
					pcmpeqq xmm1, xmm1
					pxor xmm0, xmm1
					psubq xmm0, xmm1
			end_switch
			; int3
			movq [.this.value], xmm0
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			; int3
			jmp end_case
		case +'"'
			mov [.this.jType], JSONTypes.STRING
			mov pdx, [.lpLen]
			inc dword[pdx]
			inc psi
			mov [.this.lpStr], psi
			mov [.this.isConst], 1
			mov [.ctx.escaped], 0
			$call Utf8|iterate(psi, -1, .utf8_callback_string, &.ctx)
			dec psi
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			sub pax, 2
			mov [.this.len], eax
			$call Utf8|unEsc([.this.lpStr], [.this.lpStr], eax)
			sub [.this.len], eax
			add eax, [.this.len]
			add eax, 2
			jmp end_case
		case '['
			mov [.this.jType], JSONTypes.ARRAY
			mov [.this.selectedNode], NULL
			mov pdx, [.lpLen]
			inc dword[pdx]
			inc psi
			$call CNV|alloc(addr 4 + 4 + JSONNode.ARRAY_DEFAULT_SIZE * sizeof.JSONNode)
			mov [.this.subNodes], pax
			mov [pax + JSONFlatArray.capacity], JSONNode.ARRAY_DEFAULT_SIZE
			mov [pax + JSONFlatArray.len], 0
			mov [.ctx.lpRoot], pbx
			mov [.ctx.state], JSONIterArrCtxState.comma
			$call Utf8|iterate(psi, -1, .utf8_callback_array, &.ctx)
			dec psi
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			jmp end_case
		case '{'
			mov [.this.jType], JSONTypes.OBJECT
			mov [.this.selectedNode], NULL
			mov pdx, [.lpLen]
			inc dword[pdx]
			inc psi
			$call [.this.subNodes] = CNV|alloc(sizeof.SimpleDict)
			$call SimpleDict|make([.this.subNodes], JSONNode.ARRAY_DEFAULT_SIZE)
			mov [.ctx.lpRoot], pbx
			mov [.ctx.state], JSONIterArrCtxState.comma
			mov [.ctx.keyEsc], 0
			$call Utf8|iterate(psi, -1, .utf8_callback_object, &.ctx)

			dec psi
			sub [.ctx.end], psi
			mov pax, [.ctx.end]
			jmp end_case
		case_default
			.local .jsonExcept:JSONException
			mov [.jsonExcept.lpSmb], psi
			mov pax, [.ctx.pUtf8Len]
			mov eax, dword[pax]
			mov [.jsonExcept.pointIndex], pax
			$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
			; $call c [printf]("Unexpected character %c\n", byte[psi])
			; $call [ExitProcess](0)
	end_switch
	ret

	.consts dptr .false, .true 
		.true 	@const db "true", 0
		.false 	@const db "false", 0
	.null_c @const db "null", 0

	.utf8_callback_null = .utf8_callback_bool
	
	.proc cdecl .utf8_callback_bool(.lpSmb, .codepoint:DWORD, .lParam, .lpSkipBytes)
		@sarg @arg2
		@larg pax, @arg1
		virtObj .ctx JSONIterContext at pcx from @arg3
		mov [.ctx.end], pax

		mov pdx, [.ctx.pUtf8Len]
		inc dword[pdx]

		mov pdx, [.ctx.cmpstr]
		inc [.ctx.cmpstr]
		movzx edx, byte[pdx]
		test edx, edx
			cmovz eax, edx
			jz .return
		cmp edx, [.codepoint]
			jne .error
		.return: ret
		.error:
			.local .jsonExcept:JSONException
			mov [.jsonExcept.lpSmb], pax
			mov pax, [.ctx.pUtf8Len]
			mov eax, dword[pax]
			mov [.jsonExcept.pointIndex], pax
			$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
			; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
			; $call [ExitProcess](0)
	.endp

	.proc cdecl .utf8_callback_number(.lpSmb, .codepoint, .lParam, .lpSkipBytes)
		@larg pax, @arg1, pdx, @arg2
		virtObj .ctx JSONIterContext at pcx from @arg3
		mov [.ctx.end], pax
		
		mov pax, [.ctx.pUtf8Len]
		inc dword[pax]
		
		mov pax, [.ctx.end]
		
		.local .jsonExcept:JSONException
		switch edx
			case +"0" ... +"9"
				switch [.ctx.state]
					case JSONIterNumCtxState.integer
						movq xmm0, [.ctx.result.intVal]
						movq xmm1, xmm0
						psllq xmm1, 2
						paddq xmm0, xmm1
						psllq xmm0, 1
						sub edx, "0"
						movd xmm2, edx
						paddq xmm0, xmm2
						movq [.ctx.result.intVal], xmm0
						jmp .return
					case_default ; JSONIterNumCtxState.order, JSONIterNumCtxState.dot 
						mov [.ctx.state], JSONIterNumCtxState.fractal
						cmp edx, "0"
						jne @f
							mov [.ctx.state], JSONIterNumCtxState.order
							inc [.ctx.result.order]
							jmp .return
						@@:
					case JSONIterNumCtxState.fractal
						movq xmm0, [.ctx.result.fracVal]
						movq xmm1, xmm0
						psllq xmm1, 2
						paddq xmm0, xmm1
						psllq xmm0, 1
						sub edx, "0"
						movd xmm2, edx
						paddq xmm0, xmm2
						movq [.ctx.result.fracVal], xmm0
						jmp .return
					case JSONIterNumCtxState.e
						mov [.ctx.state], JSONIterNumCtxState.exp
					case JSONIterNumCtxState.exp
						movzx eax, [.ctx.result.expVal]
						lea eax, [eax*5]
						shl eax, 1
						sub edx, "0"
						add eax, edx
						mov [.ctx.result.expVal], ax
						mov eax, esp
						jmp .return
				end_switch
			case "."
				switch [.ctx.state]
					case JSONIterNumCtxState.integer
						mov [.ctx.state], JSONIterNumCtxState.order
						jmp .return
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
				end_switch
			case "e", "E"
				switch [.ctx.state]
					case JSONIterNumCtxState.order
						mov [.ctx.result.order], 0
					case JSONIterNumCtxState.integer, JSONIterNumCtxState.fractal
						mov [.ctx.state], JSONIterNumCtxState.e
						jmp .return
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
				end_switch
			case "+", "-"
				switch [.ctx.state]
					case JSONIterNumCtxState.e
						mov [.ctx.negExp], esp
						jmp .return
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
				end_switch
			case_default
				movd xmm0, [.ctx.state]
				switch [.ctx.state]
					case JSONIterNumCtxState.integer, JSONIterNumCtxState.fractal, JSONIterNumCtxState.exp, JSONIterNumCtxState.order
						mov pax, [.ctx.pUtf8Len]
						dec dword[pax]
						xor eax, eax
						jmp .return
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
				end_switch
		end_switch
		.return: ret
	.endp

	.proc cdecl .utf8_callback_string(.lpSmb, .codepoint, .lParam, .lpSkipBytes)
		@larg pax, @arg1
		virtObj .ctx JSONIterContext at pcx from @arg3
		
		mov pcx, [.ctx.pUtf8Len]
		inc dword[pcx]

		mov pcx, @arg3
		
		cmp [.ctx.escaped], 0
		je @f
			mov [.ctx.escaped], 0
			ret
		@@:
		switch @arg2
			case "\"
				mov [.ctx.escaped], 1
			case_default
				ret
			case '"'
				mov [.ctx.strEnd], pax
				inc pax
				mov [.ctx.end], pax
				xor pax, pax
		end_switch
		.return: ret
	.endp

	.proc cdecl .utf8_callback_array(.lpSmb, .codepoint, .lParam, .lpSkipBytes)
		@sarg @arg4
		; int3
		@larg pax, @arg1
		virtObj .ctx JSONIterContext at pcx from @arg3
		
		mov pcx, [.ctx.pUtf8Len]
		inc dword[pcx]
		@larg pcx, @arg3
		
		.local .jsonExcept:JSONException
		switch @arg2
			case ']'
				inc pax
				mov [.ctx.end], pax
				xor pax, pax
			case 0Ah, " ", 09h, 0Dh
				ret
			case ","
				mov [.ctx.state], JSONIterArrCtxState.comma
				ret
			case_default
				cmp [.ctx.state], JSONIterArrCtxState.comma
				je @f
					mov [.jsonExcept.lpSmb], pax
					mov pax, [.ctx.pUtf8Len]
					mov eax, dword[pax]
					mov [.jsonExcept.pointIndex], pax
					$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
					; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
					; $call [ExitProcess](0)
				@@:
				mov [.ctx.state], JSONIterArrCtxState.noСomma
				mov pdx, [.ctx.pUtf8Len]
				dec dword[pdx]
				$call c .new_element(&.ctx, pax)
				mov pdx, [.lpSkipBytes]
				mov pointer[pdx], pax
		end_switch
		.return: ret

		.proc cdecl .new_element(.p_ctx, .lpStr) uses pbx psi pdi
			virtObj .ctx JSONIterContext at pbx from @arg1
			@larg psi, @arg2
			virtObj .root JSONNode at pdi from [.ctx.lpRoot]

			.local .result:POINTER, .new:P_JSONNode

			$call [.new] = CNV|alloc(sizeof.JSONNode)
			
			$call [.new]::__from_string(psi, [.ctx.pUtf8Len])
			mov pointer[.result], pax
			$call .root::append([.new])
			mov pax, [.result]
			ret
		.endp 
	.endp

	.proc cdecl .utf8_callback_object(.lpSmb, .codepoint, .lParam, .lpSkipBytes)
		@sarg @arg4
		@larg pax, @arg1
		virtObj .ctx JSONIterContext at pcx from @arg3
		
		mov pcx, [.ctx.pUtf8Len]
		inc dword[pcx]
		mov pcx, @arg3

		.local .jsonExcept:JSONException
		cmp [.ctx.keyEsc], 0
		je @f
			mov [.ctx.keyEsc], 0
			ret
		@@:
		switch @arg2
			case '}'
				switch [.ctx.state]
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
					case JSONIterObjCtxState.comma, JSONIterObjCtxState.noСomma
						inc pax
						mov [.ctx.end], pax
						xor pax, pax
				end_switch
			case 0Ah, " ", 09h, 0Dh
				ret
			case ","
				switch [.ctx.state]
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
					case JSONIterObjCtxState.noСomma
						mov [.ctx.state], JSONIterObjCtxState.comma
					case JSONIterObjCtxState.comma
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
					case JSONIterObjCtxState.keyOpened 
						ret
				end_switch
			case ":"
				switch [.ctx.state]
					case JSONIterObjCtxState.keyClosed
						mov [.ctx.state], JSONIterObjCtxState.colon
					case JSONIterObjCtxState.keyOpened
						ret
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
				end_switch
			case '"'
				switch [.ctx.state]
					case JSONIterObjCtxState.comma
						mov [.ctx.state], JSONIterObjCtxState.keyOpened
						inc pax
						mov [.ctx.lpKey], pax
						ret
					case JSONIterObjCtxState.keyOpened
						mov [.ctx.state], JSONIterObjCtxState.keyClosed
						mov pdx, [.ctx.lpKey]
						; int3
						sub pax, [.ctx.lpKey]
						; neg eax
						mov [.ctx.keyLen], eax
						ret
				end_switch
			case_default
				switch [.ctx.state]
					case JSONIterObjCtxState.keyOpened
						cmp @arg2, '\'
						jne @f
							mov [.ctx.keyEsc], 1
						@@:
						ret
					case_default
						mov [.jsonExcept.lpSmb], pax
						mov pax, [.ctx.pUtf8Len]
						mov eax, dword[pax]
						mov [.jsonExcept.pointIndex], pax
						; $call c [printf]("%c\n", @arg2)
						$call Exception|raise(Exception.EXCEPTION_RETURN, sizeof.JSONException shr pointer.shift, &.jsonExcept)
						; $call c [printf]("Unexpected character %c, place: %s\n", edx, pax)
						; $call [ExitProcess](0)
					case JSONIterObjCtxState.colon
						mov [.ctx.state], JSONIterObjCtxState.noСomma
						mov pdx, [.ctx.lpRoot]
						mov pdx, [pdx + JSONNode.subNodes]
						movptr xmm0, pdx
						mov pdx, [.ctx.pUtf8Len]
						dec dword[pdx]

						$call c .new_element(pointer xmm0, &.ctx, pax)
						; int3
						mov pdx, [.lpSkipBytes]
						mov pointer[pdx], pax
						; jmp .return
				end_switch
				; jmp .return
		end_switch
		.return: ret

		.proc cdecl .new_element(.lpSimpleDict, .p_ctx, .lpStr) uses pbx psi pdi
			virtObj .dict SimpleDict at pbx from @arg1
			virtObj .ctx JSONIterContext at pdi from @arg2
			@larg psi, @arg3

			.local .result:POINTER, .new:POINTER
			$call [.new] = CNV|alloc(sizeof.JSONNode)
			
			; int3
			$call JSONNode|__from_string([.new], psi, [.ctx.pUtf8Len])
			mov pointer[.result], pax
			lea pdx, [psi + pax]
			; int3

			$call Utf8|unEsc([.ctx.lpKey], [.ctx.lpKey], [.ctx.keyLen])
			sub [.ctx.keyLen], eax
			$call .dict::set([.ctx.lpKey], [.ctx.keyLen], [.new], 1)
			mov pax, [.result]
			ret
		.endp
	.endp
.endp

.proc cdecl JSONNode.append(.pthis, .lpNode) uses pbx psi
	virtObj .this JSONNode at pbx from @arg1
	@larg pdx, @arg2
	movzx eax, [.this.jType]
	and eax, 0x7
	jmp [.type_handlers + pax * pointer.size]
	.return: ret

	.type_handlers dptr .number,\ 
		.string,\ 
		.bool,\ 
		.array,\ 
		.object,\
		.null,\
		.parse_string,\
		.integer,\
		.unknown

	.null:
	.number:
	.string:
	.bool:
	.object:
	.integer:
		mov eax, JSONRetCodes.UNUSED_TYPE
		jmp .return
	
	.array:
		; array select
		virtObj .subNodes JSONFlatArray at psi from [.this.subNodes]
		mov eax, [.subNodes.len]
		cmp eax, [.subNodes.capacity] 
		jb @f
			@sarg @arg2
			shl eax, 1
			mov [.subNodes.capacity], eax
			$call psi = CNV|realloc(psi, addr sizeof.JSONFlatArray + pax * pointer.size)
			mov [.this.subNodes], psi
			mov eax, [.subNodes.len]
			mov pdx, [.lpNode]
		@@:
		inc [.subNodes.len]
		mov pointer[.subNodes.data + pax * pointer.size], pdx
		mov eax, JSONRetCodes.SUCCESS
		jmp .return
	
	.parse_string:
	.unknown:
		mov eax, JSONRetCodes.UNKNOWN_TYPE
		jmp .return
.endp 

.proc cdecl JSONNode.select(.pthis, .key, .keyLen) uses pbx psi pdi
	virtObj .this JSONNode at pbx from @arg1
	virtObj .selected JSONNode at psi from addr .this
	@sarg @arg2, @arg3
	switch [.this.jType]
		case JSONTypes.ARRAY, JSONTypes.OBJECT
			cmp [.this.selectedNode], NULL
				cmovne psi, [.this.selectedNode]
			jmp end_case
		case_default
	end_switch

	mov eax, JSONRetCodes.UNUSED_TYPE
	movzx ecx, [.selected.jType]
	and ecx, 0x7
	jmp [.type_handlers + pcx * pointer.size]
	.return: ret

	.type_handlers dptr .return,\ 
		.return,\ 
		.return,\ 
		.array,\ 
		.object,\
		.return,\
		.parse_string,\
		.return,\
		.unknown

	.array:
		@larg pdx, @arg2
		; array select
		mov pax, [.selected.subNodes]
		mov pcx, JSONRetCodes.INVALID_KEY
		cmp edx, [pax + JSONFlatArray.len]
			cmovae pax, pcx
			jae .return
		mov pdx, pointer[pax + JSONFlatArray.data + pdx * pointer.size]
		mov [.this.selectedNode], pdx
		mov pax, JSONRetCodes.SUCCESS
		jmp .return
	
	.object:
		virtObj .dict SimpleDict at pdi from [.selected.subNodes]
		$call .dict::get(@arg2, @arg3, NULL)
		mov pdx, pax
		mov pax, JSONRetCodes.INVALID_KEY
		cmp pdx, NULL
			je .return 
		mov [.this.selectedNode], pdx
		mov pax, JSONRetCodes.SUCCESS
		jmp .return

	.parse_string:
	.unknown:
		mov eax, JSONRetCodes.UNKNOWN_TYPE
		jmp .return
.endp

.proc cdecl JSONNode.get(.pthis, .key, .keyLen, .notFoundVal) uses psi pdi
	virtObj .this JSONNode at pcx from @arg1
	virtObj .selected JSONNode at psi from addr .this

	switch [.this.jType]
		case JSONTypes.ARRAY, JSONTypes.OBJECT
			cmp [.this.selectedNode], NULL
			cmovne psi, [.this.selectedNode]

			switch [.selected.jType]
				case JSONTypes.ARRAY
					@larg pdx, @arg2
					; array select
					mov pax, [.selected.subNodes]
					cmp edx, [pax + JSONFlatArray.len]
						cmovae pax, @arg4
						jae .return
					mov pax, pointer[pax + JSONFlatArray.data + pdx * pointer.size]
					.return: ret

				case JSONTypes.OBJECT
					cmp [.this.selectedNode], NULL
						cmovne psi, [.this.selectedNode]
					virtObj .dict SimpleDict at pdi from [.selected.subNodes]
					$call .dict::get(@arg2, @arg3, @arg4)
					ret
			end_switch

		case_default
			@larg pax, @arg4
			ret
	end_switch
.endp

.proc cdecl JSONNode.reset(.pthis)
	@larg pcx, @arg1
	mov [pcx + JSONNode.selectedNode], NULL
	ret
.endp

.proc cdecl JSONNode.forEach(.pthis, .func, .lParam) uses pbx psi pdi pbp
	virtObj .this JSONNode at pbx from @arg1
	@sarg @arg2, @arg3
	
	switch [.this.jType]
		case JSONTypes.ARRAY, JSONTypes.OBJECT
			cmp [.this.selectedNode], NULL
			cmovne pbx, [.this.selectedNode]
	end_switch

	mov eax, JSONRetCodes.UNKNOWN_TYPE
	switch [.this.jType]
		case JSONTypes.ARRAY
			virtObj .list JSONFlatArray at psi from [.this.subNodes]
			mov eax, JSONRetCodes.SUCCESS
			cmp [.list.len], 0
				je .return
				
			mov edi, [.list.len]
			; imul edi, edi, sizeof.JSONNode
			lea pdi, [.list.data + pdi * pointer.size]
			lea psi, [.list.data]
			xor pbp, pbp
			@block
				$call c [.func](pointer[psi], ebp, NULL, [.lParam])
				test eax, eax
					jz @fb
				inc pbp
				add psi, pointer.size
				cmp psi, pdi
				jne @sb
			@endb
			mov eax, JSONRetCodes.SUCCESS
			jmp .return

		case JSONTypes.OBJECT
			virtObj .dict SimpleDict at psi from [.this.subNodes]
			$call .dict::forEach(.dict_callback, <va_list [.func], [.lParam]>)
			mov eax, JSONRetCodes.SUCCESS
			jmp .return

		case JSONTypes.STRING, JSONTypes.BOOL, JSONTypes.NUMBER, JSONTypes.INTEGER
			mov eax, JSONRetCodes.UNUSED_TYPE
	end_switch
	.return: ret

	.proc cdecl .dict_callback(.p_key, .value, .lParam) uses pbx
		@sarg @arg2
		virtObj .key SimpleDictKey at pcx from @arg1
		@larg pbx, @arg3
		$call c pointer[pbx]([.value], [.key.key], [.key.len], pointer[pbx + pointer.size])
		ret
	.endp
.endp

.proc cdecl JSONNode.getLen(.pthis)
	virtObj .this JSONNode at pcx from @arg1
	virtObj .selected JSONNode at pdx from addr .this
	
	switch [.this.jType]
		case JSONTypes.ARRAY, JSONTypes.OBJECT
			cmp [.this.selectedNode], NULL
			cmovne pdx, [.this.selectedNode]
		case_default
			switch [.selected.jType]
				case JSONTypes.ARRAY
					mov pax, [.selected.subNodes]
					mov eax, [pax + JSONFlatArray.len]
					ret

				case JSONTypes.OBJECT
					mov pax, [.selected.subNodes]
					mov eax, [pax + SimpleDict.len]
					ret

				case JSONTypes.STRING
					mov eax, [.selected.len]
					ret

				case_default
					mov pax, -1
					ret
			end_switch
	end_switch
.endp

; macro JSONNode.unmake{}
.proc cdecl JSONNode.unmake(.pthis) uses pbx
	virtObj .this JSONNode at pbx from @arg1
	
	switch [.this.jType]
		case JSONTypes.STRING
			cmp [.this.isConst], 0
			jne @f
				$call CNV|free([.this.lpStr])
			@@:
		case_default ; JSONTypes.BOOL, JSONTypes.NULL, JSONTypes.NUMBER
			ret

		case JSONTypes.OBJECT, JSONTypes.ARRAY
	end_switch
	
	$call .this::reset()::forEach(.json_callback, NULL)

	switch [.this.jType]
		case JSONTypes.OBJECT
			$call [.this.subNodes]::unmake()
		case_default ; JSONTypes.ARRAY
			$call CNV|free([.this.subNodes])
	end_switch
	ret

	.proc cdecl .json_callback(.node:P_JSONNode, .key, .keyLen, .lParam)
		@sarg @arg1
		
		$call [.node]::unmake()
		$call CNV|free([.node])
		mov eax, esp
		ret
	.endp
.endp

.proc_frame_mode_previous
