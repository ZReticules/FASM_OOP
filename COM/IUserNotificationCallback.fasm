.proc_frame_mode_static

.proc stdcall IUserNotificationCallback_s.QueryInterface(.pthis)
	@larg pdx, @arg2, pax, @arg3
	mov pointer[pax], NULL
	
	movups xmm0, xword[pdx]
	movups xmm1, [IID_IUnknown]
	pcmpeqq xmm1, xmm0
	movhlps xmm2, xmm1
	pand xmm1, xmm2

	movups xmm1, [IID_IUserNotificationCallback]
	pcmpeqq xmm0, xmm1
	movhlps xmm1, xmm0
	pand xmm0, xmm1

	por xmm0, xmm1
	movq xmm0, xmm0

	ptest xmm0, xmm0
	jz @f
		virtObj .this IUserNotificationCallback_s at pcx from @arg1
		mov pointer[pax], pcx
		$call .this::AddRef()
		mov eax, S_OK
		ret
	@@:
	mov pointer[pax], NULL
	mov eax, E_NOINTERFACE
	ret
.endp

.proc stdcall IUserNotificationCallback_s.OnBalloonUserClick(.pthis, .pt:POINTER)
	mov eax, E_NOTIMPL
	ret
.endp

if used IUserNotificationCallback_s.OnContextMenu

IUserNotificationCallback_s.OnContextMenu = IUserNotificationCallback_s.OnBalloonUserClick

end if

if used IUserNotificationCallback_s.OnLeftClick

IUserNotificationCallback_s.OnLeftClick = IUserNotificationCallback_s.OnBalloonUserClick

end if

.proc_frame_mode_previous
