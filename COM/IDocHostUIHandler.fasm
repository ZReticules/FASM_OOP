.proc stdcall IDocHostUIHandler_s.GetDropTarget(.pthis, .pchKey:POINTER, .ppDropTarget:POINTER)
	cmp @arg3, NULL
	je @f
		@larg pdx, @arg3
		mov pointer[pdx], NULL
	@@:
	mov eax, E_NOTIMPL
	ret
.endp

.proc stdcall IDocHostUIHandler_s.GetExternal(.pthis, .ppDispatch:POINTER)
	cmp @arg2, NULL
	je @f
		@larg pdx, @arg2
		mov pointer[pdx], NULL
	@@:
	mov eax, E_NOTIMPL
	ret
.endp

IDocHostUIHandler_s.TranslateUrl = IDocHostUIHandler_s.ResizeBorder

