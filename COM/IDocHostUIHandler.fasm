.proc_frame_mode_static

.proc stdcall IDocHostUIHandler_s.QueryInterface(.pthis, .riid:P_GUID, .ppvObject:POINTER)
	@sarg @arg1
	@larg pdx, @arg2, pax, @arg3
	mov pointer[pax], NULL
	; int3
	
	movups xmm0, xword[pdx]
	movups xmm1, [IID_IUnknown]
	pcmpeqq xmm1, xmm0
	movhlps xmm2, xmm1
	pand xmm1, xmm2

	movups xmm1, [IID_IDocHostUIHandler]
	pcmpeqq xmm0, xmm1
	movhlps xmm1, xmm0
	pand xmm0, xmm1

	por xmm0, xmm1
	movq xmm0, xmm0

	ptest xmm0, xmm0
	jz @f
		virtObj .this IDocHostUIHandler_s at pcx from @arg1
		mov pointer[pax], pcx
		$call .this::AddRef()
		mov eax, S_OK
		ret
	@@:
	
	mov pointer[pax], NULL
	mov eax, E_NOINTERFACE
	ret
.endp

.proc stdcall IDocHostUIHandler_s.ShowContextMenu(.pthis, .dwID:DWORD, .ppt:POINTER, .pcmdtReserved:P_IUnknown, .pdispReserved:P_IDispatch)
	mov eax, S_FALSE
	ret
.endp

.proc stdcall IDocHostUIHandler_s.GetHostInfo(.pthis, .pInfo:POINTER)
