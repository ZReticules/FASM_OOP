proc String.make c uses pbx, this, size
    virtObj .this:arg String at pbx from @arg1
    @larg pdx, @arg2
    mov [.this.len], 0
    cmp edx, String.SHORT_STRING_LEN
        jg .real_alloc
    mov [.this.__size], DW_BE_PSIZE
    ret

    .real_alloc:
        bswap edx
        mov [.this.__size], edx
        bswap edx
        @call CNV::alloc(addr edx + 1)
        mov [.this.__lpChars], pax
        ret
endp

proc String.reallocParam c uses pbx, this, size, minify
    virtObj .this:arg String at pbx from @arg1
    @larg pdx, @arg2
    local memBuf:POINTER
    
    switch @arg3
        case 0
            mov eax, [.this.__size]
            bswap eax
            cmp eax, edx
                jae .return
    end_switch
    cmp edx, String.SHORT_STRING_LEN
    seta al
    mov ecx, [.this.__size]
    bswap ecx
    cmp ecx, String.SHORT_STRING_LEN
    seta cl
    and ecx, 0x1
    and eax, 0x1
    lea eax, [eax + ecx * 2]
    jmp pointer[.variants + pax * pointer.size]

    .variants:
        dptr .both_low
        dptr .dest_low
        dptr .src_low
        dptr .no_low

    .both_low:
        mov [.this.__size], DW_BE_PSIZE
        ret

    .dest_low:
        bswap edx
        mov [.this.__size], edx
        bswap edx
        @call [memBuf] = CNV::alloc(addr edx + 1)
        @call CNV::fill(pax, addr .this.__lpChars, String.SHORT_STRING_LEN)
        mov pax, [memBuf]
        mov [.this.__lpChars], pax
        .return: ret

    .src_low:
        mov [.this.__size], DW_BE_PSIZE
        mov pax, [.this.__lpChars]
        mov [memBuf], pax
        @call CNV::fill(addr .this.__lpChars, pax, String.SHORT_STRING_LEN)
        cmp [.this.len], String.SHORT_STRING_LEN
        jb .no_resize
            mov [.this.len], String.SHORT_STRING_LEN
        .no_resize:
        @call CNV::free([memBuf])
        ret

    .no_low:
        bswap edx
        mov [.this.__size], edx
        bswap edx
        cmp [.this.len], edx
        jb .no_cut
            mov [.this.len], edx
        .no_cut:
        @call CNV::realloc([.this.__lpChars], addr edx + 1)
        mov [.this.__lpChars], pax
        mov edx, [.this.len]
        mov byte[pax + pdx], 0
        ret
endp

proc String.unmake c, this
    @sarg @arg1
    virtObj .this:arg String at pcx from @arg1
    xor pax, pax
    xchg pax, [.this.__lpChars]
    mov [.this.len], 0
    mov edx, [.this.__size]
    bswap edx
    mov [.this.__size], DW_BE_PSIZE
    cmp edx, String.SHORT_STRING_LEN
    jbe .no_free
        @call CNV::free(pax)
    .no_free:
    ret
endp

proc String.fromChars c uses pbx psi pdi, this, lpChars, bCount
    virtObj .this:arg String at pbx from @arg1
    cmp @arg3, 0
        je .zero_bytes
    @sarg @arg2, @arg3
    @larg pax, @arg3
    cmp eax, -1
    jne .no_asciiz
        @call CNV::strlen(@arg2)
        test pax, pax
            jz .zero_bytes
        mov [bCount], pax
    .no_asciiz:
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        @call .this->realloc([bCount])
    .no_realloc:
    ; mov eax, [.this.__size]
    @call .this->getLpChars()
    mov pdi, pax
    mov psi, [lpChars]
    mov pcx, [bCount]
    mov [.this.len], ecx
    rep movsb
    mov byte[pdi], 0
    ret

    .zero_bytes:
        @call .this->flush()
        ret
endp

proc String.addChars c uses pbx psi pdi, this, lpChars, bCount
    cmp @arg3, 0
        je .return
    virtObj .this:arg String at pbx from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    cmp eax, -1
    jne .no_asciiz
        @call CNV::strlen(@arg2)
        test pax, pax
            jz .return
        mov [bCount], pax
    .no_asciiz:
    add eax, [.this.len]
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        @call .this->realloc(addr eax + 1)
    .no_realloc:
    @call .this->getLpChars()
    mov edi, [.this.len]
    add pdi, pax
    mov psi, [lpChars]
    mov pcx, [bCount]
    add [.this.len], ecx
    rep movsb
    mov byte[pdi], 0
    .return: ret
endp

proc String.fromString c uses psi, this, lpString
    virtObj .other:arg String at psi from @arg2
    @sarg @arg1
    @call .other->getLpChars()
    @call String::fromChars([this], pax, [.other.len])
    ret
endp

proc String.addString c uses psi, this, lpString
    virtObj .other:arg String at psi from @arg2
    @sarg @arg1
    @call .other->getLpChars()
    @call String::addChars([this], pax, [.other.len])
    ret
endp

proc String.slice c uses psi pdi pbx, this, source, _start, _end
    virtObj .this:arg String at pdi from @arg1
    virtObj .src:arg String at psi from @arg2
    @sarg @arg3, @arg4
    cmp dword[_start], 0
    jge .no_neg_low
        mov eax, [.src.len]
        add dword[_start], eax
        cmp dword[_start], 0
        jg .no_out_low_bound
            mov [_start], 0
        .no_out_low_bound:
    .no_neg_low:
    cmp dword[_end], 0
    jge .no_neg_high
        mov eax, [.src.len]
        add dword[_end], eax
        cmp dword[_end], 0
        jg .no_out_high_bound
            mov [_end], 0
        .no_out_high_bound:
    .no_neg_high:
    mov ebx, dword[_end]
    cmp ebx, [.src.len]
        cmova ebx, [.src.len]
    sub ebx, dword[_start]
        jbe .empty
    cmp ebx, [.this.len]
    jbe .no_realloc
        @call .this->realloc(ebx)
    .no_realloc:
    @call .src->getLpChars()
    mov psi, pax
    add psi, [_start]
    @call .this->getLpChars()
    mov [.this.len], ebx
    mov pdi, pax
    mov pcx, pbx
    rep movsb
    mov byte[pdi], 0
    ret

    .empty:
        @call .this->flush()
        ret
endp

proc String.fromChar c uses pdi, this, bVal, bCount
    cmp @arg3, 0
        je .flush
    virtObj .this:arg String at pdi from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    mov edx, [.this.__size]
    bswap edx
    cmp edx, eax
    jae .no_realloc
        @call .this->realloc(pax)
    .no_realloc:
    @call .this->getLpChars()
    mov pcx, [bCount]
    mov [.this.len], ecx
    mov pdi, pax
    mov pax, [bVal]
    rep stosb
    mov byte[pdi], 0
    ret
    .flush:
        @call String::flush(@arg1)
        ret
endp

proc String.addChar c uses pdi, this, bVal, bCount
    cmp @arg3, 0
        je .return
    virtObj .this:arg String at pdi from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    add eax, [.this.len]
    mov edx, [.this.__size]
    bswap edx
    cmp edx, eax
    jae .no_realloc
        @call .this->realloc(pax)
    .no_realloc:
    @call .this->getLpChars()
    mov edx, [.this.len]
    mov pcx, [bCount]
    add [.this.len], ecx
    lea pdi, [pax + pdx]
    mov pax, [bVal]
    rep stosb
    mov byte[pdi], 0
    .return: ret
endp

proc String.fromInt c uses pbx psi, this, num, radix, isSigned
    @sarg @arg2, @arg3
    @larg psi, @arg4

    virtObj .this:arg String at pbx from @arg1

    and psi, 1
    mov edx, [.this.__size]
    bswap edx
    cmp edx, 66
    jae .no_realloc
        @call .this->realloc(65)
    .no_realloc:
    @call .this->getLpChars()
    @call c [.funcs + psi * pointer.size](pax, [num], [radix])
    mov [.this.len], eax
    ret
    .funcs dptr CNV.uintToStr, CNV.intToStr
endp

proc String.addInt c uses pbx psi, this, num, radix, isSigned
    @sarg @arg2, @arg3
    @larg psi, @arg4
    virtObj .this:arg String at pbx from @arg1

    mov eax, [.this.len]
    add eax, 66
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        @call .this->realloc(pax)
    .no_realloc:
    @call .this->getLpChars()
    mov ecx, [.this.len]
    add pcx, pax
    and psi, 1
    @call c [.funcs + psi * pointer.size](pcx, [num], [radix])
    add [.this.len], eax
    ret

    .funcs dptr CNV.uintToStr, CNV.intToStr
endp

proc String.fromInt64 c uses pbx psi, this, num:QWORD, radix, isSigned
    @sarg @arg2, @arg3
    @larg psi, @arg4

    virtObj .this:arg String at pbx from @arg1

    and psi, 1
    mov edx, [.this.__size]
    bswap edx
    cmp edx, 66
    jae .no_realloc
        @call .this->realloc(65)
    .no_realloc:
    @call .this->getLpChars()
    @call c [.funcs + psi * pointer.size](pax, [num], [radix])
    mov [.this.len], eax
    ret
    .funcs dptr CNV.ui64ToStr, CNV.i64ToStr
endp

proc String.addInt64 c uses pbx psi, this, num:QWORD, radix, isSigned
    @sarg @arg2, @arg3
    @larg psi, @arg4
    virtObj .this:arg String at pbx from @arg1

    mov eax, [.this.len]
    add eax, 66
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        @call .this->realloc(pax)
    .no_realloc:
    @call .this->getLpChars()
    mov ecx, [.this.len]
    add pcx, pax
    and psi, 1
    @call c [.funcs + psi * pointer.size](pcx, [num], [radix])
    add [.this.len], eax
    ret

    .funcs dptr CNV.ui64ToStr, CNV.i64ToStr
endp

proc String.sprintf c uses psi pbx pdi pbp, this, fmtstr, vargs, v3, v4
    @sarg @arg1, @arg2, @arg3, @arg4
    @larg psi, @arg2
    virtObj .this:arg String at pbx from @arg1 
    locals 
        buf String 0, 0, 0
        result String
    endl
    mov edx, [.this.__size]
    bswap edx
    @call result->make(edx)
    @call buf->make(256)
    xor pbp, pbp
    mov pdi, psi
    .loop1:
        ; mov eax, [result.len]
        movzx eax, byte[psi]
        cmp eax, "%"
            je .fmt
        inc psi
    cmp al, 0
    jne .loop1
    sub psi, pdi
    dec psi
    @call result->addChars(pdi, psi)
    @call .this->unmake()
    @call buf->unmake()
    @call CNV::fill(addr .this, addr result, sizeof.String, FILL_NO_SAVE)
    ret

    .types:
        dptr .character
        dptr .decimal
        dptr .unsigned
        dptr .hex
        dptr .oct
        dptr .asciiz
        dptr .String
        dptr .float
        dptr .float
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr .percent

    .fmt:
        locals
            flags       dd 0x0040
            width       dd -1
            precision   dd -1
            uns_base    dd ?
            numeric_len dd ?
            numeric_buf db 64 dup(?)
            pDouble     ParsedDouble
        endl

        sub psi, pdi
        test psi, psi
        jz .no_bytes
            @call result->addChars(pdi, psi);->print()
            ; @call c [puts]("")
        .no_bytes:
        @call buf->flush()
        movzx eax, byte[pdi + psi + 1]
        add pdi, 2
        ; mov ecx, eax          ; ecx - type
        ; and ecx, 0xF
        test eax, FSTR_HAS_FLAGS
        jz .no_flags
            movzx edx, byte[pdi + psi]
            mov [flags], edx
            inc pdi
        .no_flags:
        test eax, FSTR_HAS_WIDTH
        jz .no_width
            mov edx, [pdi + psi]
            lea pcx, [pbp + pointer.size]
            cmp edx, -2
            cmove edx, dword[vargs + pbp]
            cmove ebp, ecx
            mov [width], edx
            add pdi, 4
        .no_width:
        test eax, FSTR_HAS_PRECISION
        jz .no_precision
            mov edx, [pdi + psi]
            lea pcx, [pbp + pointer.size]
            cmp edx, -2
            cmove edx, dword[vargs + pbp]
            cmove ebp, ecx
            mov [precision], edx
            add pdi, 4
        .no_precision:
        and eax, 0xF
        jmp pointer[.types + eax * pointer.size]

    .end_fmt:
        cmp [width], -1
        je .after_correct
        mov eax, [buf.len]
        cmp [width], eax
        jb .after_correct
            sub [width], eax
            test [flags], FSTR_MINUS_FLAG
            jz .no_reverse
                @call result->addString(addr buf)
                @call result->addChar(+" ", [width])
                add psi, pdi
                mov pdi, psi
                jmp .loop1
            .no_reverse:
            @call result->addChar(+" ", [width])
        .after_correct:
        ; @call buf->getLpChars()
        ; @call c [printf]("%d:%s\n", [buf.len], pax)
        @call result->addString(addr buf);->print()
        ; @call c [puts]("")
        add psi, pdi
        mov pdi, psi
        jmp .loop1


    .character:
        cmp [precision], -1
        jne .no_char_precision
            mov [precision], 1
        .no_char_precision:
        @call buf->fromChar([vargs + pbp], [precision])
        add pbp, pointer.size
        jmp .end_fmt

    .decimal:
        mov eax, [flags]
        and eax, FSTR_SIZE
        switch [flags]
            case FSTR_SIZE_QWORD
                test dword[vargs + pbp + 4], 80000000h
                match =x86, __architecture{
                        jz .no_dec_neg
                    @call buf->fromChar(+"-", 1)
                    neg [vargs + pbp]
                    adc [vargs + pbp + 4], 0
                    neg [vargs + pbp + 4]
                    jmp .check_precision
                }
                match =x64, __architecture{
                    jmp end_case
                }
            case FSTR_SIZE_BYTE
                test dword[vargs + pbp], 80h
                jmp end_case
            case FSTR_SIZE_WORD
                test dword[vargs + pbp], 8000h
                jmp end_case
            case_default
                test dword[vargs + pbp], 80000000h
        end_switch
        jz .no_dec_neg
            @call buf->fromChar(+"-", 1)
            neg [vargs + pbp]
            jmp .check_precision
        .no_dec_neg:
            xor edx, edx
            mov eax, "+"
            test [flags], FSTR_PLUS_FLAG
            cmovnz edx, eax
            mov eax, " "
            test [flags], FSTR_SPACE_FLAG
            cmovnz edx, eax
            test edx, edx
            jz .no_dec_start
                @call buf->fromChar(edx, 1)
            .no_dec_start:
        .check_precision:
        ; @call CNV::uintToStr(addr numeric_buf, [vargs + pbp], 10)

        mov [uns_base], 10
        jmp .unumeric

    .unsigned:
        mov [uns_base], 10
        jmp .unumeric

    .hex:
        mov [uns_base], 16
        jmp .unumeric

    .oct:
        mov [uns_base], 8
        ; jmp .unumeric

    .unumeric:
        mov eax, [flags]
        and eax, FSTR_SIZE
        switch [flags]
            match =x86, __architecture{
                case FSTR_SIZE_QWORD
                    @call CNV::ui64ToStr(addr numeric_buf, qword[vargs + pbp], [uns_base])
                    add pbp, 8
                    jmp .check_precision_unumeric
            }
            case FSTR_SIZE_BYTE
                movzx pax, byte[vargs + pbp]
                add pbp, pointer.size
                jmp end_case
            case FSTR_SIZE_WORD
                movzx pax, word[vargs + pbp]
                add pbp, pointer.size
                jmp end_case
            case_default
                mov pax, pointer[vargs + pbp]
                add pbp, pointer.size
        end_switch
        @call CNV::uintToStr(addr numeric_buf, pax, [uns_base])

        .check_precision_unumeric:
        cmp [precision], -1
        je .no_uns_precision
        cmp eax, [precision]
        ja .no_uns_precision
            mov [numeric_len], eax
            sub [precision], eax
            @call buf->addChar(+"0", [precision])
            mov eax, [numeric_len]
        .no_uns_precision:

        @call buf->addChars(addr numeric_buf, eax)
        jmp .end_fmt

    .asciiz:
        ; mov eax, -1

        ; cmp eax, -1
        ; je .no_asciiz_precision
        @call CNV::strlen([vargs + pbp])
        cmp eax, [precision]
            cmova eax, [precision]
        ; .no_asciiz_precision:
        @call buf->fromChars([vargs + pbp], eax)
        add pbp, pointer.size
        jmp .end_fmt

    .String:
        ; mov eax, [precision]
        cmp [precision], -1
        je .no_string_precision
        mov pax, [vargs + pbp]
        mov ecx, [pax + String.len]
        cmp ecx, [precision]
        jbe .no_string_precision
            @call String::getLpChars([vargs + pbp])
            mov pdx, pax
            @call buf->fromChars(pdx, [precision])
            add pbp, pointer.size
            jmp .end_fmt
        .no_string_precision:

        @call buf->fromString([vargs + pbp])
        add pbp, pointer.size
        jmp .end_fmt

    .percent:
        @call buf->fromChar(+"%", 1)
        jmp .end_fmt

    .float:
        virtual at uns_base
            .normalization dd ?
        end virtual
        mov edx, 6
        mov ecx, 1
        sub eax, 7
        test eax, eax
            cmovnz edx, ecx
        mov [.normalization], edx
        mov eax, [flags]
        and eax, FSTR_SIZE
        switch [flags]
            case FSTR_SIZE_WORD
                test dword[vargs + pbp], 0x8000
                lahf
                and dword[vargs + pbp], 0x7FFF
                vcvtph2ps xmm0, qword[vargs + pbp]
                cvtss2sd xmm0, xmm0
                add pbp, pointer.size
                jmp end_case
            case FSTR_SIZE_QWORD
                test dword[vargs + pbp + 4], 0x80000000
                lahf
                and dword[vargs + pbp + 4], 0x7FFFFFFF
                movq xmm0, qword[vargs + pbp]
                add pbp, 8
                jmp end_case
            case_default
                test dword[vargs + pbp], 0x80000000
                lahf
                and dword[vargs + pbp], 0x7FFFFFFF
                cvtss2sd xmm0, dword[vargs + pbp]
                add pbp, pointer.size
        end_switch
        movq qword[numeric_buf], xmm0
        sahf
        jz .no_float_neg
            @call buf->fromChar(+"-", 1)
            jmp .check_precision_float
        .no_float_neg:
            xor edx, edx
            mov eax, "+"
            test [flags], FSTR_PLUS_FLAG
            cmovnz edx, eax
            mov eax, " "
            test [flags], FSTR_SPACE_FLAG
            cmovnz edx, eax
            test edx, edx
            jz .no_float_start
                @call buf->fromChar(edx, 1)
            .no_float_start:
        .check_precision_float:
        mov edx, 5
        mov eax, [precision]
        cmp [precision], -1
        cmove eax, edx
        @call pDouble->parseDouble(double [numeric_buf], eax, [.normalization])
        movq xmm0, [pDouble.fracVal]
        movsx eax, [pDouble.sign]
        cmp eax, 0
        jl .error_num
            @call buf->addInt64([pDouble.intVal], 10, 0)
            movq xmm0, [pDouble.fracVal]
            ptest xmm0, xmm0
            jz @f
                @call buf->addChar(+".", 1)->addChar(+"0", [pDouble.order])->addInt64([pDouble.fracVal], 10, 0)
            @@:
            cmp [pDouble.expVal], 0
            je @f
                @call buf->addChar(+"e", 1)
                movsx pax, [pDouble.expVal]
                @call buf->addInt(pax, 10, 1)
            @@:
            jmp .end_fmt
        .error_num:
        ; mov pax, _inf
        shr pax, 1
        and pax, 1
        @call buf->addChars(pointer[.errors + pax * pointer.size], 3)
        jmp .end_fmt

        .inf @const db "inf"
        .nan @const db "NaN"
        .errors @const dptr .nan, .inf
endp

proc String.streamRead c uses pbx psi pdi pbp, this, fp, delimiter:DWORD, delimiter_callback, eof_callback, lParam
    .len_buf = 4096
    @sarg @arg2, @arg3, @arg4
    @larg pbp, @arg2
    virtObj .this:arg String at pbx from @arg1
    local saveAx:DWORD

    xor psi, psi
    .string_realloc:
        @call .this->getLpChars()
        mov pdi, pax
        .read_chars:
            @call c [fgetc](pbp)
            switch eax
                case -1, 0x1A, [delimiter]
                    mov [saveAx], eax
                    mov edx, 0x1A
                    cmp eax, -1
                    cmove eax, edx
                    cmp eax, 0x1A
                    sete al
                    cmp [delimiter_callback + pax * pointer.size], NULL
                        cmove eax, [saveAx]
                        je end_case

                    mov byte[pdi + psi], 0
                    mov [.this.len], esi

                    mov psi, [delimiter_callback + pax * pointer.size]
                    @call c psi(addr .this, [lParam])
                    xor esi, esi
                    test eax, eax
                        jz .return
                    mov eax, [saveAx]
            end_switch
            mov byte[pdi + psi], al
            inc psi
        mov edx, [.this.__size]
        bswap edx
        cmp esi, edx
        jl .read_chars
        @call .this->realloc(addr pdx + .len_buf)
    jmp .string_realloc

    .return: ret
endp

proc String.read c, this, fp
    virtObj .this:arg String at pcx from @arg1
    local result:POINTER
    @call .this->streamRead(@arg2, 0Ah, .newLineCallback, .eofCallback, addr result)
    mov pax, [result]
    ret
endp

proc .eofCallback c string, lParam
    @larg pax, @arg2
    mov pax, [lParam]
    mov pointer[pax], -1
    mov eax, 0
    ret
endp

proc .newLineCallback c string, lParam
    @larg pcx, @arg1, \
        pdx, @arg2
    mov eax, [pcx + String.len]
    mov [pdx], pax 
    mov eax, 0
    ret
endp

proc String.parseInt c uses pbx psi pdi pbp, this, radix
    @sarg @arg1, @arg2
    @larg pax, @arg2

    local maxDigit:DWORD
    lea edx, [eax + "0"]
    lea ecx, [eax + "A" - 10]
    cmp edx, "9" + 1
        cmova edx, ecx
    mov [maxDigit], edx

    mov pbp, .mul
    mov edx, eax
    dec edx
    test eax, edx
    jnz .no_power_two
        mov pbp, .shift
        bsr pax, [radix]
    .no_power_two:
    mov [radix], pax

    @call String::getLpChars([this])
    mov pbx, pax
    mov pcx, [radix]
    mov edx, 1
    xor esi, esi
    cmp byte[pbx], "-"
        cmove esi, edx
    xor eax, eax

    .digits_loop:
        movzx edi, byte[pbx + psi]
        switch edi
            case u "9" ... "A"
            case_default
                ; mov pcx, pax
                ; neg pcx
                cmp byte[pbx], "-"
                    jne .return
                neg pax
                .return: ret
            case u +"a" ... +"f"
                and edi, 0DFh
                jmp start_case
            case u +"0" ... [maxDigit]
                jmp pbp
                .after_digit:
                lea edx, [edi - "A" + 10]
                sub edi, "0"
                cmp edi, 9
                    cmova edi, edx
                add pax, pdi
                inc psi
        end_switch
    jmp .digits_loop

    .mul:
        imul eax, ecx
        jmp .after_digit

    .shift:
        shl eax, cl
        jmp .after_digit
endp

proc String.cmpChars c uses psi pdi, this, lpChars, bCount
    @sarg @arg2
    virtObj .this:arg String at psi from @arg1
    @larg pcx, @arg3
    ; int3
    cmp pcx, -1
    jne .len_isset
        @call CNV::strlen(@arg2, STRLEN_REZULT_CX or STRLEN_NO_SAVE)
    .len_isset:
    cmp ecx, [.this.len]
        cmova ecx, [.this.len]
    inc pcx
    mov [bCount], pcx
    @call .this->getLpChars()
    mov psi, pax
    mov pdi, [lpChars]
    mov pcx, [bCount]
    repe cmpsb
    lahf
    ret
endp

proc String.cmpString c uses psi pdi, this, other
    virtObj .this:arg String at psi from @arg1
    virtObj .other:arg String at pdi from @arg2
    local bCount:POINTER
    mov ecx, [.other.len]
    cmp ecx, [.this.len]
        cmova ecx, [.this.len]
    inc pcx
    mov [bCount], pcx
    @call .this->getLpChars()
    mov psi, pax
    @call .other->getLpChars()
    mov pdi, pax
    mov pcx, [bCount]
    repe cmpsb
    lahf
    ret
endp

