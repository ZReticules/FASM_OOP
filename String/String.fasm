proc_noprologue

; importlib msvcrt, \
;     fgetc="_fgetc"

define DW_BE_PSIZE (pointer.size * 01000000h)

macro String.print this, fp=[stdout]{
    @call String::getLpChars(this)
    @call c [fputs](pax, fp)
}

macro String.println this, fp=[stdout]{
    @call String::getLpChars(this)
    @call c [puts](pax)
}

macro String.getLpChars this{
    local _this, check_dx
    inlineObj _this, this, pcx
    lea pax, [_this + String.__chars]

    reg_in_addr check_dx, dx, _this
    if ~check_dx
        mov edx, [_this + String.__size]
        bswap edx
        cmp edx, String.SHORT_STRING_LEN
    else
        mov ecx, [_this + String.__size]
        bswap ecx
        cmp ecx, String.SHORT_STRING_LEN
    end if
    cmova pax, [_this + String.__lpChars]
}

; returns pointer to string data
macro String.flush this{
    local _this
    inlineObj _this, this, pcx
    mov [_this + String.len], 0
    @call String::getLpChars(this)
    mov pointer[pax], 0
}

macro String.input this{
    @call String::read(this, [stdin])
}

macro String.realloc this, size, minify=0{
    @call String::reallocParam(this, size, minify)
}

