.proc_frame_mode_static

macro WString.print this, fp=[stdout]{
    $call getLpWChars<WString>(this)
    $call c [fputws](pax, fp)
}

macro WString.println this{
    $call getLpWChars<WString>(this)
    $call c [putws](pax)
}

macro WString.getLpWChars this{
    local _this, check_dx
    inlineObj _this, this, pcx
    lea pax, [_this + WString.__wchars]

    reg_in_addr check_dx, dx, _this
    if ~check_dx
        mov edx, [_this + WString.__size]
        bswap edx
        cmp edx, WString.SHORT_STRING_LEN
    else
        mov ecx, [_this + WString.__size]
        bswap ecx
        cmp ecx, WString.SHORT_STRING_LEN
    end if
    cmova pax, [_this + WString.__lpWChars]
}

; returns pointer to string data
macro WString.flush this{
    local _this
    inlineObj _this, this, pcx
    mov [_this + WString.len], 0
    $call getLpWChars<WString>(this)
    mov pointer[pax], 0
}

macro WString.input this{
    $call read<WString>(this, [stdin])
}

macro WString.realloc this, size, minify=0{
    $call reallocParam<WString>(this, size, minify)
}

.proc cdecl WString.make(.pthis, .size) uses pbx
    virtObj .this WString at pbx from @arg1
    @larg pdx, @arg2
    mov [.this.len], 0
    cmp edx, WString.SHORT_STRING_LEN
        jg .real_alloc
    mov [.this.__size], WString.SHORT_STRING_LEN_BE
    ret

    .real_alloc:
        bswap edx
        mov [.this.__size], edx
        bswap edx
        $call CNV|alloc(addr (edx + 1) * 2)
        mov [.this.__lpWChars], pax
        ret
.endp

.proc cdecl WString.reallocParam(.pthis, .size, .minify) uses pbx
    virtObj .this WString at pbx from @arg1
    @larg pdx, @arg2
    .local .memBuf:POINTER
    
    cmp @arg3, 0
    jne .true_minify
        mov eax, [.this.__size]
        bswap eax
        cmp eax, edx
            jae .return
    .true_minify:
    cmp edx, WString.SHORT_STRING_LEN
    seta al
    mov ecx, [.this.__size]
    bswap ecx
    cmp ecx, WString.SHORT_STRING_LEN
    seta cl
    and ecx, 0x1
    and eax, 0x1
    lea eax, [eax + ecx * 2]
    jmp pointer[.variants + pax * pointer.size]

    .variants:
        dptr .both_low
        dptr .dest_low
        dptr .src_low
        dptr .no_low

    .both_low:
        mov [.this.__size], WString.SHORT_STRING_LEN_BE
        .return: ret

    .dest_low:
        mov eax, edx
        bswap eax
        mov [.this.__size], eax
        $call [.memBuf] = CNV|alloc(addr (edx + 1) * 2)
        $call CNV|fill(pax, addr .this.__lpWChars, WString.SHORT_STRING_LEN * 2)
        mov pax, [.memBuf]
        mov [.this.__lpWChars], pax
        ret

    .src_low:
        mov [.this.__size], WString.SHORT_STRING_LEN_BE
        mov pax, [.this.__lpWChars]
        mov [.memBuf], pax
        $call CNV|fill(addr .this.__lpWChars, pax, WString.SHORT_STRING_LEN * 2)
        cmp [.this.len], WString.SHORT_STRING_LEN
        jb .no_resize
            mov [.this.len], WString.SHORT_STRING_LEN
        .no_resize:
        $call CNV|free([.memBuf])
        ret

    .no_low:
        mov eax, edx
        bswap eax
        mov [.this.__size], eax
        cmp [.this.len], edx
        jb .no_cut
            mov [.this.len], edx
        .no_cut:
        $call CNV|realloc([.this.__lpWChars], addr (edx + 1) * 2)
        mov [.this.__lpWChars], pax
        mov edx, [.this.len]
        mov word[pax + pdx * 2], 0
        ret
.endp

.proc cdecl WString.unmake(.pthis)
    @sarg @arg1
    virtObj .this WString at pcx from @arg1
    xor pax, pax
    xchg pax, [.this.__lpWChars]
    mov [.this.len], 0
    mov edx, [.this.__size]
    bswap edx
    mov [.this.__size], WString.SHORT_STRING_LEN_BE
    cmp edx, WString.SHORT_STRING_LEN
    jbe .no_free
        $call CNV|free(pax)
    .no_free:
    ret
.endp

.proc cdecl WString.fromWChars(.pthis, .lpWChars, .wCount) uses pbx psi pdi
    virtObj .this WString at pbx from @arg1
    cmp @arg3, 0
        je .zero_bytes
    @sarg @arg2, @arg3
    @larg pax, @arg3
    cmp eax, -1
    jne .no_asciiz
        $call CNV|wstrlen(@arg2)
        test pax, pax
            jz .zero_bytes
        mov [.wCount], pax
    .no_asciiz:
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        $call .this::realloc([.wCount])
    .no_realloc:
    ; mov eax, [.this.__size]
    $call pdi = .this::getLpWChars()
    mov psi, [.lpWChars]
    mov pcx, [.wCount]
    mov [.this.len], ecx
    rep movsw
    mov word[pdi], 0
    ret

    .zero_bytes:
        $call .this::flush()
        ret
.endp

.proc cdecl WString.addWChars(.pthis, .lpWChars, .wCount) uses pbx psi pdi
    cmp @arg3, 0
        je .return
    virtObj .this WString at pbx from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    cmp eax, -1
    jne .no_asciiz
        $call CNV|wstrlen(@arg2)
        test eax, eax
            jz .return
        mov [.wCount], pax
    .no_asciiz:
    add eax, [.this.len]
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        $call .this::realloc(addr (eax + 1) * 2)
    .no_realloc:
    ; int3
    $call .this::getLpWChars()
    mov edi, [.this.len]
    lea pdi, [pax + pdi * 2]
    mov psi, [.lpWChars]
    mov pcx, [.wCount]
    add [.this.len], ecx
    rep movsw
    mov word[pdi], 0
    .return: ret
.endp

.proc cdecl WString.fromWString(.pthis, .pother) uses psi
    virtObj .other WString at psi from @arg2
    @sarg @arg1
    $call .other::getLpWChars()
    $call fromWChars<WString>([.pthis], pax, [.other.len])
    ret
.endp

.proc cdecl WString.addWString(.pthis, .pother) uses psi
    virtObj .other WString at psi from @arg2
    @sarg @arg1
    $call .other::getLpWChars()
    $call addWChars<WString>([.pthis], pax, [.other.len])
    ret
.endp

.proc cdecl WString.slice(.pthis, .source, .start, ._end) uses psi pdi pbx
    virtObj .this WString at pdi from @arg1
    virtObj .src WString at psi from @arg2
    @sarg @arg3, @arg4
    cmp dword[.start], 0
    jge .no_neg_low
        mov eax, [.src.len]
        add dword[.start], eax
        cmp dword[.start], 0
        jg .no_out_low_bound
            mov [.start], 0
        .no_out_low_bound:
    .no_neg_low:
    cmp dword[._end], 0
    jge .no_neg_high
        mov eax, [.src.len]
        add dword[._end], eax
        cmp dword[._end], 0
        jg .no_out_high_bound
            mov [._end], 0
        .no_out_high_bound:
    .no_neg_high:
    mov ebx, dword[._end]
    cmp ebx, [.src.len]
        cmova ebx, [.src.len]
    sub ebx, dword[.start]
        jbe .empty
    cmp ebx, [.this.len]
    jbe .no_realloc
        $call .this::realloc(ebx)
    .no_realloc:
    $call psi = .src::getLpWChars()
    shl [.start], 1
    add psi, [.start]
    $call .this::getLpWChars()
    mov [.this.len], ebx
    mov pdi, pax
    mov pcx, pbx
    rep movsw
    mov word[pdi], 0
    ret

    .empty:
        $call .this::flush()
        ret
.endp

.proc cdecl WString.fromWChar(.pthis, .wVal, .wCount) uses pdi
    cmp @arg3, 0
        je .flush
    virtObj .this WString at pdi from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    mov edx, [.this.__size]
    bswap edx
    cmp edx, eax
    jae .no_realloc
        $call .this::realloc(pax)
    .no_realloc:
    $call .this::getLpWChars()
    mov pcx, [.wCount]
    mov [.this.len], ecx
    mov pdi, pax
    mov pax, [.wVal]
    rep stosw
    mov word[pdi], 0
    ret
    .flush:
        $call flush<WString>(@arg1)
        ret
.endp

.proc cdecl WString.addWChar(.pthis, .wVal, .wCount) uses pdi
    cmp @arg3, 0
        je .return
    virtObj .this WString at pdi from @arg1
    @sarg @arg2, @arg3
    @larg pax, @arg3
    add eax, [.this.len]
    mov edx, [.this.__size]
    bswap edx
    cmp edx, eax
    jae .no_realloc
        $call .this::realloc(pax)
    .no_realloc:
    $call .this::getLpWChars()
    mov edx, [.this.len]
    mov pcx, [.wCount]
    add [.this.len], ecx
    lea pdi, [pax + pdx * 2]
    mov pax, [.wVal]
    rep stosw
    mov word[pdi], 0
    .return: ret
.endp

.proc cdecl WString.fromInt(.pthis, .num, .radix, .isSigned) uses pbx psi
    @sarg @arg2, @arg3
    @larg psi, @arg4

    virtObj .this WString at pbx from @arg1

    and psi, 1
    mov edx, [.this.__size]
    bswap edx
    cmp edx, 66
    jae .no_realloc
        $call .this::realloc(65)
    .no_realloc:
    $call .this::getLpWChars()
    $call c [.funcs + psi * pointer.size](pax, [.num], [.radix], 2)
    mov [.this.len], eax
    ret

    .funcs dptr CNV.uintToStrVarchar, CNV.intToStrVarchar
.endp

.proc cdecl WString.addInt(.pthis, .num, .radix, .isSigned) uses pbx psi
    @sarg @arg2, @arg3
    @larg psi, @arg4
    virtObj .this WString at pbx from @arg1

    mov eax, [.this.len]
    add eax, 66
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        $call .this::realloc(pax)
    .no_realloc:
    $call .this::getLpWChars()
    mov ecx, [.this.len]
    lea pcx, [pax + pcx * 2]
    and psi, 1
    $call c [.funcs + psi * pointer.size](pcx, [.num], [.radix], 2)
    add [.this.len], eax
    ret

    .funcs dptr CNV.uintToStrVarchar, CNV.intToStrVarchar
.endp

.proc cdecl WString.fromInt64(.pthis, .num:QWORD, .radix, .isSigned) uses pbx psi
    @sarg @arg2, @arg3
    @larg psi, @arg4

    virtObj .this WString at pbx from @arg1

    and psi, 1
    mov edx, [.this.__size]
    bswap edx
    cmp edx, 66
    jae .no_realloc
        $call .this::realloc(65)
    .no_realloc:
    $call .this::getLpWChars()
    $call c [.funcs + psi * pointer.size](pax, [.num], [.radix], 2)
    mov [.this.len], eax
    ret

    .funcs dptr CNV.ui64ToStrVarchar, CNV.i64ToStrVarchar
.endp

.proc cdecl WString.addInt64(.pthis, .num:QWORD, .radix, .isSigned) uses pbx psi
    @sarg @arg2, @arg3
    @larg psi, @arg4
    virtObj .this WString at pbx from @arg1

    mov eax, [.this.len]
    add eax, 66
    mov edx, [.this.__size]
    bswap edx
    cmp eax, edx
    jbe .no_realloc
        $call .this::realloc(pax)
    .no_realloc:
    $call .this::getLpWChars()
    mov ecx, [.this.len]
    lea pcx, [pax + pcx * 2]
    and psi, 1
    $call c [.funcs + psi * pointer.size](pcx, [.num], [.radix], 2)
    add [.this.len], eax
    ret

    .funcs dptr CNV.ui64ToStrVarchar, CNV.i64ToStrVarchar
.endp

.proc cdecl WString.vsprintf(.pthis, .fmtstr, .vlist) uses psi pbx pdi pbp
    @sarg @arg1, @arg2, @arg3
    @larg psi, @arg2, pbp, @arg3

    virtObj .this WString at pbx from @arg1 
    .local .buf:WString, .result:WString
    mov edx, [.this.__size]
    bswap edx
    $call .result::make(edx)
    $call .buf::make(256)
    mov pdi, psi
    .loop1:
        movzx eax, word[psi]
        cmp eax, "%"
            je .fmt
        add psi, 2
    cmp ax, 0
    jne .loop1
    sub psi, pdi
    shr psi, 1
    dec psi
    $call .result::addWChars(pdi, psi)
    $call .this::unmake()
    $call .buf::unmake()
    $call CNV|fill(&.this, &.result, sizeof.WString, FILL_NO_SAVE)
    ret

    .types:
        dptr .character
        dptr .decimal
        dptr .unsigned
        dptr .hex
        dptr .oct
        dptr .asciiz
        dptr .WString
        dptr .float
        dptr .float
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr ?
        dptr .percent

    .fmt:
        ; int3
        .locals
            .flags       rd 1
            .width       rd 1
            .precision   rd 1
            .uns_base    rd 1
            .numeric_len rd 1
            .numeric_buf rw 128
            .pDouble     ParsedDouble
        .endl
        $call CNV|fill(addr .flags, <const dd 0x0040, -1, -1>, 12)
        sub psi, pdi
        test psi, psi
        jz .no_bytes
            shr psi, 1
            $call .result::addWChars(pdi, psi)
            shl psi, 1
        .no_bytes:
        $call .buf::flush()
        movzx eax, byte[pdi + psi + 2]
        add pdi, 3
        test eax, FSTR_HAS_FLAGS
        jz .no_flags
            movzx edx, byte[pdi + psi]
            mov [.flags], edx
            add pdi, 1
        .no_flags:
        test eax, FSTR_HAS_WIDTH
        jz .no_width
            mov edx, [pdi + psi]
            lea pcx, [pbp + pointer.size]
            cmp edx, -2
            cmove edx, dword[pbp]
            cmove ebp, ecx
            mov [.width], edx
            add pdi, 4
        .no_width:
        test eax, FSTR_HAS_PRECISION
        jz .no_precision
            mov edx, [pdi + psi]
            lea pcx, [pbp + pointer.size]
            cmp edx, -2
            cmove edx, dword[pbp]
            cmove ebp, ecx
            mov [.precision], edx
            add pdi, 4
        .no_precision:
        and eax, 0xF
        jmp pointer[.types + eax * pointer.size]

    .end_fmt:
        cmp [.width], -1
        je .after_correct
        mov eax, [.buf.len]
        cmp [.width], eax
        jb .after_correct
            sub [.width], eax
            test [.flags], FSTR_MINUS_FLAG
            jz .no_reverse
                $call .result::addWString(addr .buf)
                $call .result::addWChar(+" ", [.width])
                add psi, pdi
                mov pdi, psi
                jmp .loop1
            .no_reverse:
            $call .result::addWChar(+" ", [.width])
        .after_correct:
        ; int3
        $call .result::addWString(&.buf);::println()
        add psi, pdi
        mov pdi, psi
        jmp .loop1


    .character:
        cmp [.precision], -1
        jne .no_char_precision
            mov [.precision], 1
        .no_char_precision:
        $call .buf::fromWChar(pointer[pbp], [.precision])
        add pbp, pointer.size
        jmp .end_fmt

    .decimal:
        mov eax, [.flags]
        and eax, FSTR_SIZE
        switch [.flags]
            case FSTR_SIZE_QWORD
                test dword[pbp + 4], 80000000h
                match =x86, __architecture{
                        jz .no_dec_neg
                    $call .buf::fromWChar(+"-", 1)
                    neg pointer[pbp]
                    adc pointer[pbp + 4], 0
                    neg pointer[pbp + 4]
                    jmp .check_precision
                }
                match =x64, __architecture{
                    jmp end_case
                }
            case FSTR_SIZE_BYTE
                test dword[pbp], 80h
                jmp end_case
            case FSTR_SIZE_WORD
                test dword[pbp], 8000h
                jmp end_case
            case_default
                test dword[pbp], 80000000h
        end_switch
        jz .no_dec_neg
            $call .buf::fromWChar(+"-", 1)
            neg pointer[pbp]
            jmp .check_precision
        .no_dec_neg:
            xor edx, edx
            mov eax, "+"
            test [.flags], FSTR_PLUS_FLAG
            cmovnz edx, eax
            mov eax, " "
            test [.flags], FSTR_SPACE_FLAG
            cmovnz edx, eax
            test edx, edx
            jz .no_dec_start
                $call .buf::fromWChar(edx, 1)
            .no_dec_start:
        .check_precision:

        mov [.uns_base], 10
        jmp .unumeric

    .unsigned:
        mov [.uns_base], 10
        jmp .unumeric

    .hex:
        mov [.uns_base], 16
        jmp .unumeric

    .oct:
        mov [.uns_base], 8
        ; jmp .unumeric

    .unumeric:
        mov eax, [.flags]
        and eax, FSTR_SIZE
        switch [.flags]
            match =x86, __architecture{
                case FSTR_SIZE_QWORD
                    $call CNV|ui64ToWStr(addr .numeric_buf, qword[pbp], [.uns_base])
                    add pbp, 8
                    jmp .check_precision_unumeric
            }
            case FSTR_SIZE_BYTE
                movzx pax, byte[pbp]
                add pbp, pointer.size
                jmp end_case
            case FSTR_SIZE_WORD
                movzx pax, word[pbp]
                add pbp, pointer.size
                jmp end_case
            case_default
                mov pax, pointer[pbp]
                add pbp, pointer.size
        end_switch
        $call CNV|uintToWStr(addr .numeric_buf, pax, [.uns_base])

        .check_precision_unumeric:
        cmp [.precision], -1
        je .no_uns_precision
        cmp eax, [.precision]
        ja .no_uns_precision
            mov [.numeric_len], eax
            sub [.precision], eax
            $call .buf::addWChar(+"0", [.precision])
            mov eax, [.numeric_len]
        .no_uns_precision:

        $call .buf::addWChars(addr .numeric_buf, eax);::println()
        ; $call c [printf]("%d\n", [.buf.len])
        jmp .end_fmt

    .asciiz:
        $call CNV|wstrlen(pointer[pbp])
        cmp eax, [.precision]
            cmova eax, [.precision]
        $call .buf::fromWChars(pointer[pbp], eax)
        add pbp, pointer.size
        jmp .end_fmt

    .WString:
        cmp [.precision], -1
        je .no_string_precision
        mov pax, [pbp]
        mov ecx, [pax + WString.len]
        cmp ecx, [.precision]
        jbe .no_string_precision
            $call getLpWChars<WString>(pointer[pbp])
            mov pdx, pax
            $call .buf::fromWChars(pdx, [.precision])
            add pbp, pointer.size
            jmp .end_fmt
        .no_string_precision:

        $call .buf::fromWString(pointer[pbp])
        add pbp, pointer.size
        jmp .end_fmt

    .percent:
        $call .buf::fromWChar(+"%", 1)
        jmp .end_fmt

    .float:
        virtual at .uns_base
            .normalization dd ?
        end virtual
        mov edx, 6
        mov ecx, 1
        sub eax, 7
        test eax, eax
            cmovnz edx, ecx
        mov [.normalization], edx
        mov eax, [.flags]
        and eax, FSTR_SIZE
        switch [.flags]
            case FSTR_SIZE_WORD
                test dword[pbp], 0x8000
                lahf
                and dword[pbp], 0x7FFF
                vcvtph2ps xmm0, qword[pbp]
                cvtss2sd xmm0, xmm0
                add pbp, pointer.size
                jmp end_case
            case FSTR_SIZE_QWORD
                test dword[pbp + 4], 0x80000000
                lahf
                and dword[pbp + 4], 0x7FFFFFFF
                movq xmm0, qword[pbp]
                add pbp, 8
                jmp end_case
            case_default
                test dword[pbp], 0x80000000
                lahf
                and dword[pbp], 0x7FFFFFFF
                cvtss2sd xmm0, dword[pbp]
                add pbp, pointer.size
        end_switch
        movq qword[.numeric_buf], xmm0
        sahf
        jz .no_float_neg
            $call .buf::fromWChar(+"-", 1)
            jmp .check_precision_float
        .no_float_neg:
            xor edx, edx
            mov eax, "+"
            test [.flags], FSTR_PLUS_FLAG
            cmovnz edx, eax
            mov eax, " "
            test [.flags], FSTR_SPACE_FLAG
            cmovnz edx, eax
            test edx, edx
            jz .no_float_start
                $call .buf::fromWChar(edx, 1)
            .no_float_start:
        .check_precision_float:
        mov edx, 5
        mov eax, [.precision]
        cmp [.precision], -1
        cmove eax, edx
        $call .pDouble::parseDouble(double [.numeric_buf], eax, [.normalization])
        movq xmm0, [.pDouble.fracVal]
        movsx eax, [.pDouble.sign]
        cmp eax, 0
        jl .error_num
            cmp [.normalization], 1
            jne .no_exp_key
            cmp dword[.pDouble.intVal + 4], 0
            jne .no_exp_key
            cmp dword[.pDouble.intVal], 0
            jne .no_exp_key
                $call [.numeric_len] = CNV|ui64ToWStr(addr .numeric_buf, [.pDouble.fracVal], 10)
                $call CNV|ui64pow(qword 10, addr pax - 1)
                ; int3
                $call CNV|ui64div(addr .pDouble, [.pDouble.fracVal], qword_result)
                $call CNV|ui64ToWStr(addr .numeric_buf, [.pDouble.fracVal], 10)
                inc eax
                sub eax, [.numeric_len]
                sub [.pDouble.order], eax
                dec [.pDouble.expVal]
            .no_exp_key:
            $call .buf::addInt64([.pDouble.intVal], 10, 0)
            movq xmm0, [.pDouble.fracVal]
            ptest xmm0, xmm0
            jz @f
                $call .buf::addWChar(+".", 1)::addWChar(+"0", [.pDouble.order])::addInt64([.pDouble.fracVal], 10, 0)
            @@:
            cmp [.pDouble.expVal], 0
            je @f
                $call .buf::addWChar(+"e", 1)
                movsx pax, [.pDouble.expVal]
                $call .buf::addInt(pax, 10, 1)
            @@:
            jmp .end_fmt
        .error_num:
        ; mov pax, _inf
        shr pax, 1
        and pax, 1
        $call .buf::addWChars(pointer[.errors + pax * pointer.size], 3)
        jmp .end_fmt

        .inf @const db "inf"
        .nan @const db "NaN"
        .errors @const dptr .nan, .inf
.endp

.proc cdecl WString.sprintf(.pthis, .fmtstr, .va_args, .arg4)
    @sarg @arg3, @arg4
    $call vsprintf<WString>(@arg1, @arg2, &.va_args)
    ret
.endp

.proc cdecl WString.streamRead(.pthis, .fp, .delimiter:DWORD, .delimiter_callback, .eof_callback, .lParam) uses pbx psi pdi pbp
    .len_buf = 4096
    @sarg @arg2, @arg3, @arg4
    @larg pbp, @arg2
    virtObj .this WString at pbx from @arg1
    .local .saveAx:DWORD

    xor psi, psi
    .string_realloc:
        $call .this::getLpWChars()
        mov pdi, pax
        .read_chars:
            $call c [fgetwc](pbp)
            switch eax
                case 0xFFFF, 0x1A, [.delimiter]
                    mov [.saveAx], eax
                    mov edx, 0x1A
                    cmp eax, 0xFFFF
                    cmove eax, edx
                    cmp eax, 0x1A
                    sete al
                    cmp [.delimiter_callback + pax * pointer.size], NULL
                        cmove eax, [.saveAx]
                        je end_case

                    mov word[pdi + psi], 0
                    shr psi, 1
                    mov [.this.len], esi

                    mov psi, [.delimiter_callback + pax * pointer.size]
                    $call c psi(addr .this, [.lParam])
                    xor esi, esi
                    test eax, eax
                        jz .return
                    mov eax, [.saveAx]
            end_switch
            mov word[pdi + psi], ax
            add psi, 2
        mov edx, [.this.__size]
        bswap edx
        cmp esi, edx
        jl .read_chars
        shr esi, 1
        mov [.this.len], esi
        shl esi, 1
        $call .this::realloc(addr pdx + .len_buf)
    jmp .string_realloc

    .return: ret
.endp

.proc cdecl WString.read(.pthis, .fp)
    .local .result:POINTER
    $call streamRead<WString>(@arg1, @arg2, 0Ah, .new_line_callback, .eof_callback, &.result)
    mov pax, [.result]
    ret

    .proc cdecl .eof_callback(.p_string, .lParam)
        @larg pax, @arg2
        mov pointer[pax], -1
        mov eax, 0
        ret
    .endp

    .proc cdecl .new_line_callback(.p_string, .lParam)
        @larg pcx, @arg1, \
            pdx, @arg2
        mov eax, [pcx + WString.len]
        mov [pdx], pax 
        mov eax, 0
        ret
    .endp
.endp

.proc cdecl WString.parseInt(.pthis, .radix) uses pbx
    @sarg @arg2
    virtObj .this WString at pbx from @arg1
    $call .this::getLpWChars()
    $call CNV|wstrToI64(pax, [.this.len], 10)
    ret
.endp

.proc cdecl WString.cmpWChars(.pthis, .lpWChars, .wCount) uses psi pdi
    @sarg @arg2
    virtObj .this WString at psi from @arg1
    @larg pcx, @arg3
    ; int3
    cmp pcx, -1
    jne .len_isset
        $call CNV|wstrlen(@arg2, STRLEN_REZULT_CX or STRLEN_NO_SAVE)
    .len_isset:
    cmp ecx, [.this.len]
        cmova ecx, [.this.len]
    inc pcx
    mov [.wCount], pcx
    $call psi = .this::getLpWChars()
    mov pdi, [.lpWChars]
    mov pcx, [.wCount]
    repe cmpsw
    lahf
    ret
.endp

.proc cdecl WString.cmpWString(.pthis, .pother) uses psi pdi
    virtObj .this WString at psi from @arg1
    virtObj .other WString at pdi from @arg2
    .local .wCount:POINTER
    mov ecx, [.other.len]
    cmp ecx, [.this.len]
        cmova ecx, [.this.len]
    inc pcx
    mov [.wCount], pcx
    $call .this::getLpWChars()
    mov psi, pax
    $call .other::getLpWChars()
    mov pdi, pax
    mov pcx, [.wCount]
    repe cmpsw
    lahf
    ret
.endp

.proc cdecl WString.countWChar(.pthis, .wVal) uses pdi
    @sarg @arg2
    virtObj .this WString at pdi from @arg1
    
    $call .this::getLpWChars()
    mov ecx, [.this.len]
    mov pdi, pax
    movzx eax, word[.wVal]
    mov edx, -1

    @@:
        repne scasw
        inc edx
    cmp ecx, 0
    jnz @b
    mov eax, edx
    ret
.endp

.proc cdecl WString.findWChar(.pthis, .startIndex, .wVal) uses pdi
    @sarg @arg2, @arg3
    virtObj .this WString at pdi from @arg1
    
    $call .this::getLpWChars()
    mov ecx, [.this.len]
    mov edx, ecx
    sub ecx, dword[.startIndex]
    mov pdi, pax
    shl [.startIndex], 1
    add pdi, [.startIndex]
    movzx eax, word[.wVal]
    repne scasw
    sub edx, ecx
    dec edx
    mov eax, -1
    ; int3
    ; movzx ecx, word[pdi]
    cmp word[pdi], 0
        cmovne eax, edx
    ret
.endp

.proc cdecl WString.findWChars(.pthis, .pWChars, .len:DWORD) uses pdi psi pbx
    @sarg @arg2, @arg3

    virtObj .this WString at pbx from @arg1
    
    cmp @arg3, -1
    jne @f
        $call [.len] = CNV|wstrlen(@arg2, STRLEN_NO_SAVE)
    @@:

    .local .lenNow:DWORD, .pSrc:POINTER
    mov pax, -1
    mov edx, [.this.len]
    cmp edx, [.len]
        jb .return

    mov [.lenNow], edx
    $call .this::getLpWChars()
    mov [.pSrc], pax
    mov psi, pax
    mov ecx, [.len]
    mov pdi, [.pWChars]
    @block
        repe cmpsw
            je .found

        add [.pSrc], 2
        dec [.lenNow]
        mov psi, [.pSrc]
        mov pdi, [.pWChars]
        mov ecx, [.len]
    cmp ecx, [.lenNow]
    @endb jbe @sb
    mov pax, -1
    .return: ret

    .found:
        $call .this::getLpWChars()
        sub psi, pax
        shr psi, 1
        mov pax, psi
        sub eax, [.len]
        ret
.endp

.proc cdecl WString.replaceWChars(.pthis, .chgIndex:DWORD, .chgLen:DWORD, .rWChars, .rLen:DWORD) uses pbx psi pdi
    @sarg @arg2, @arg3, @arg4

    virtObj .this WString at pbx from @arg1

    cmp [.rLen], -1
    jne @f
        mov [.rLen], 0
        cmp @arg4, NULL
            je @f
        $call [.rLen] = CNV|wstrlen(@arg4)
    @@:
    ; $call 
    mov eax, [.this.len]
    sub eax, [.chgLen]
    add eax, [.rLen]
    ; mov [.this.len], eax

    $call .this::realloc(eax)::getLpWChars()
    ; int3

    mov ecx, [.this.len]
    sub ecx, [.chgIndex]
    sub ecx, [.chgLen]
    
    @block jecxz @fb
        mov edx, [.chgLen]
        cmp edx, [.rLen]
        switch NULL
            case F a
                mov esi, [.chgIndex]
                add esi, edx
                lea psi, [pax + psi * 2]
                
                mov edi, [.chgIndex]
                add edi, [.rLen]
                lea pdi, [pax + pdi * 2]

                rep movsw
                jmp end_case
            case F ne
                mov esi, [.this.len]
                mov edi, esi
                lea psi, [pax + psi * 2 - 2]

                sub edi, edx
                add edi, [.rLen]
                lea pdi, [pax + pdi * 2 - 2]

                ; int3

                std
                rep movsw
                cld
        end_switch
    @endb

    mov edx, [.this.len]
    sub edx, [.chgLen]
    add edx, [.rLen]
    mov [.this.len], edx
    mov word[pax + pdx * 2], 0

    cmp [.rLen], 0
        je .return
    
    mov edi, [.chgIndex]
    lea pdi, [pax + pdi * 2]

    mov psi, [.rWChars]
    mov ecx, [.rLen]

    rep movsw
    $call .this::getLpWChars()

    .return: ret
endp

.proc_frame_mode_previous
