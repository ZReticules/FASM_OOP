importlib kernel32,\
	GetModuleHandleA

importlib gdi32,\
	BitBlt,\
	CreateRectRgn,\
	GetStockObject

importlib shell32,\
	DragQueryFileA

importlib advapi32,\
	RegGetValueA

importlib user32,\
	MessageBoxA,\
	MessageBoxW

define MAX_PATH 260

if used WND.hModule
	WND.hModule dptr ?
end if

macro WND.moduleInit{
	if used WND.hModule
		$call [GetModuleHandleA](0)
		mov [WND.hModule], pax
	end if
}

TLS_AddMacro WND.moduleInit

.proc_frame_mode_static

macro WND.msgBox lpText*, lpCaption=NULL, [args]{
	common
	local a, _lpCaption
	_lpCaption equ lpCaption
	a#dwStyle equ MB_OK
	a#hwndOwner equ NULL
	match name:val, lpCaption\{
		_lpCaption equ NULL
		restore a\#name
		a\#name equ val
	\}
	forward
	match name:val, args\{
		restore a\#name
		a\#name equ val
	\}
	common
	$call [MessageBoxA](a#hwndOwner, lpText, _lpCaption, a#dwStyle)
	; restore _lpCaption 
	; restore a#dwStyle 	
	; restore a#hwndOwner 	
}

macro WND.msgBoxW lpText*, lpCaption=NULL, [args]{
	common
	local a, _lpCaption
	_lpCaption equ lpCaption
	a#dwStyle equ MB_OK
	a#hwndOwner equ NULL
	match name:val, lpCaption\{
		_lpCaption equ NULL
		; restore a\#name
		a\#name equ val
	\}
	forward
	match name:val, args\{
		; restore a\#name
		a\#name equ val
	\}
	common
	$call [MessageBoxW](a#hwndOwner, lpText, _lpCaption, a#dwStyle)
	; restore _lpCaption 
	; restore a#dwStyle 	
	; restore a#hwndOwner 	
}

macro WND.setTimer uElapse, lpTimerFunc, nIDEvent=0, hWnd=NULL{
	$call [SetTimer](hWnd, nIDEvent, uElapse, lpTimerFunc)
}

macro WND.killTimer nIDEvent, hWnd=NULL{
	$call [KillTimer](hWnd, nIDEvent)
}

macro WND.taskDlg lpWTitle, lpWCaption=NULL, lpWContent=NULL, [args]{
	common
	local a, _lpWTitle, _lpWCaption, _lpWContent
	_lpWTitle equ lpWTitle
	_lpWCaption equ lpWCaption
	_lpWContent equ lpWContent
	a#dwCommonButtons equ TDCBF_CANCEL_BUTTON
	a#hwndOwner equ NULL
	a#pszIcon equ TD_INFORMATION_ICON
	a#pnButton equ 0
	match name:val, lpWTitle\{
		restore _lpWTitle
		_lpWTitle equ NULL
		restore a\#name
		a\#name equ val
	\}
	match name:val, lpWCaption\{
		restore _lpWCaption
		_lpWCaption equ NULL
		restore a\#name
		a\#name equ val
	\}
	match name:val, lpWContent\{
		restore _lpWContent
		_lpWContent equ NULL
		restore a\#name
		a\#name equ val
	\}
	forward
	match name:val, args\{
		restore a\#name
		a\#name equ val
	\}
	common
	$call [TaskDialog](a#hwndOwner, NULL, _lpWTitle, _lpWCaption, _lpWContent, a#dwCommonButtons, a#pszIcon, a#pnButton)
	restore _lpWTitle
	restore _lpWCaption 
	restore _lpWContent 
	restore a#dwCommonButtons 	
	restore a#hwndOwner 	
	restore a#pszIcon
	restore a#pnButton 	
}

.proc cdecl WND.repaintWindow(.hWnd, .hDC, .lpRect, .hBrush)
	@sarg @arg1, @arg2, @arg3, @arg4
	.with .gf:Graphics([.hDC])
		.local .bmpSize:POINT
		; $call .gf::createCompatible([.hDC])
		mov pcx, [.lpRect]
		mov eax, [pcx + RECT.right]
		sub eax, [pcx + RECT.left]
		mov [.bmpSize.x], eax
		mov eax, [pcx + RECT.bottom]
		sub eax, [pcx + RECT.top]
		mov [.bmpSize.y], eax
		
		; $call [CreateRectRgn]([pcx + RECT.left], [pcx + RECT.top], [pcx + RECT.right], [pcx + RECT.bottom])
		; $call .gf::selectObject(pax, Graphics.Rgn)
		; $call .gf::createObjects(\
		; 	<_BMP: [.hDC], [.bmpSize.x], [.bmpSize.y]>, \
		; )
		$call .gf::createCompatibleBMP([.hDC], [.bmpSize.x], [.bmpSize.y])
		$call [GetStockObject](WHITE_BRUSH)
		$call .gf::fillRect([.lpRect], pax)
		$call [SendMessageA]([.hWnd], WM_PRINT, [.gf.hDC], PRF_CLIENT)
		$call .gf::selectObject([.hBrush], Graphics.Brush)
		$call [PatBlt]([.gf.hDC], 0, 0, [.bmpSize.x], [.bmpSize.y], PATINVERT)
		$call [PatBlt]([.gf.hDC], 0, 0, [.bmpSize.x], [.bmpSize.y], DSTINVERT)
		$call .gf::freeObject(Graphics.Brush)
		$call [BitBlt]([.hDC], 0, 0, [.bmpSize.x], [.bmpSize.y], \
			[.gf.hDC], 0, 0, SRCCOPY)
		
		; local hBmp:POINTER
		; $call .gf::freeObject(Graphics.BMP)
		; mov [hBmp], pax
		; $call CNV|BMP2File(pax, "lol.bmp")
		; $call [DeleteObject]([hBmp])
	.end_with
	ret
.endp

.proc cdecl WND.dragFileNameString(.lpString, .hDrop, .dragIndex) uses pbx
	virtObj .strDest:arg String at pbx from @arg1
	@sarg @arg2, @arg3
	.local .fSize:POINTER
	$call [.fSize] = [DragQueryFileA]([.hDrop], @arg3, NULL, 0)
	$call .strDest::realloc([.fSize])::getLpChars()
	mov pdx, [.fSize]
	inc pdx
	$call [DragQueryFileA]([.hDrop], [.dragIndex], pax, pdx)
	mov [.strDest.len], eax
	ret
.endp

macro WND.dragFilesCount hDrop{
	$call [DragQueryFileA](hDrop, 0xFFFFFFFF, NULL, 0)
}

macro WND.isThemeLight{
	local keyVal
	procbuf_alloc keyVal, 4
	$call [RegGetValueA](\
		HKEY_CURRENT_USER,\ 
		<const db "Software\Microsoft\Windows\CurrentVersion\Themes\Personalize", 0>,\
		<const db "AppsUseLightTheme", 0>,\
		0x18,\
		NULL,\
		&keyVal,\
		va_list 4\
	)
	mov eax, [keyVal]
	bswap eax
	and eax, 1
	procbuf_free keyVal
}

