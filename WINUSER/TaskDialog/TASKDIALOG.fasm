.proc_frame_mode_static

.proc TD.TASKDIALOGHooksChecker(.hWnd, .uMsg, .wParam, .lParam, .uIdSubclass, .dwRefData) uses psi pdi pbx
	@sarg @arg1, @arg2, @arg3, @arg4
	virtObj .task TASKDIALOG at psi from [.dwRefData]
	virtObj .template TASKDIALOG_TEMPLATE at pbx from [.task.p_template]
	xor eax, eax
	mov pdi, [.task.__sData.lpHooks]
	cmp pdi, NULL
		jz .default

	movzx ecx, word[pdi]
		jecxz .default
	
	add pdi, 2
	movzx edx, word[.uMsg]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.template + pdi], 0
				jz .default

			$call std pointer[.template + pdi]([.dwRefData], &.hWnd, addr .task + pdi + pointer.size)
			jmp .return

		.not_my_event:
	loop .find_event

	.default:
		$call [DefSubclassProc]([.hWnd], [.uMsg], [.wParam], [.lParam])
	.return: ret
.endp

.proc TD.TASKDIALOGCallback(.hwnd, .msg, .wParam, .lParam, .p_refData) uses pdi pbx psi
	@sarg @arg1, @arg2, @arg3, @arg4
	@larg pdx, @arg2
	virtObj .task TASKDIALOG at pbx from [.p_refData]
	virtObj .template TASKDIALOG_TEMPLATE at psi from [.task.p_template]
	xor eax, eax
	switch @arg2
		case TDN.DIALOG_CONSTRUCTED
			@larg pax, @arg1
			mov [.task.hWnd], pax
			$call WIN|setPtr([.task.hWnd], addr .task)
			xor eax, eax

			if used TASKDIALOG.hasHooks

			$call [SetWindowSubclass]([.task.hWnd], TD.TASKDIALOGHooksChecker, -1, &.task)

			end if

		case_default

		if used TASKDIALOG.hasEvents
			pxor xmm0, xmm0
			@block
				virtObj .tevents __TEventsHeader at pdi from [.template.__sData.p_tevents]
				test pdi, pdi
					jz @fb

				movzx ecx, [.tevents.count_]
					jecxz @fb

				movzx eax, [.tevents.first]
				cmp edx, eax
					jb @fb

				add ecx, eax
				cmp edx, ecx
					jae @fb

				sub edx, eax

				movzx edi, [.tevents.events_ + pdx * 2]
				test edi, edi
					jz @fb

				cmp pointer[.template + pdi], NULL
					jz @fb

				$call std pointer[.template + pdi](&.task, &.hwnd, addr .task + pdi + pointer.size)
				movptr xmm0, pax
			@endb
			movptr pax, xmm0
			cmp [.msg], TDN.DESTROYED
			jne @f
				mov [.task.hWnd], NULL
			@@:

		end if

	end_switch
	ret
.endp

.proc cdecl TASKDIALOG.run(.pthis, .p_template:P_TASKDIALOG_TEMPLATE, .parent) uses pbx
	@sarg @arg1, @arg3
	virtObj .template TASKDIALOG_TEMPLATE at pbx from @arg2
	.local .taskConf:TASKDIALOGCONFIG
	$call CNV|fill(&.taskConf, [.template.p_config], sizeof.TASKDIALOGCONFIG)
	
	mov pax, [.parent]
	mov [.taskConf.hwndParent], pax
	mov pax, [WND.hModule]
	mov [.taskConf.hInstance], pax
	mov pcx, [.pthis]
	
	virtObj .this TASKDIALOG at pcx from [.pthis]
	mov [.this.p_template], pbx

	mov [.taskConf.lpCallbackData], pcx
	mov [.taskConf.pfCallback], TD.TASKDIALOGCallback
	$call [TaskDialogIndirect](&.taskConf, &.this.result.lastBtn,\
		&.this.result.lastRad, &.this.result.isChecked)
	ret
.endp

.proc cdecl TASKDIALOG.navigate(.p_task, .p_template:P_TASKDIALOG_TEMPLATE) uses pbx psi
	virtObj .this TASKDIALOG at psi from @arg1
	virtObj .template TASKDIALOG_TEMPLATE at pbx from @arg2
	.local .taskConf:TASKDIALOGCONFIG
	$call CNV|fill(&.taskConf, [.template.p_config], sizeof.TASKDIALOGCONFIG)

	$call [.taskConf.hwndParent] = [GetParent]([.this.hWnd])
	mov pax, [WND.hModule]
	mov [.taskConf.hInstance], pax
	mov [.this.p_template], pbx
	mov [.taskConf.lpCallbackData], psi

	mov [.taskConf.pfCallback], TD.TASKDIALOGCallback
	$call [SendMessageA]([.this.hWnd], TDM.NAVIGATE_PAGE, NULL, &.taskConf)
	; $call [TaskDialogIndirect](&.taskConf, &.this.result.lastBtn,\
	; 	&.this.result.lastRad, &.this.result.isChecked)
	ret
.endp

.proc TASKDIALOG_linkClicked(.p_task, .p_param, .p_eventData) uses pbx psi
	virtObj .this:arg TASKDIALOG at pbx from @arg1
	virtObj .params Params at psi from @arg2
	$call [ShellExecuteW](0, L 'open', [.params.lParam], 0, 0, SW_SHOW or SW_MAXIMIZE)
	$return esp
.endp

.proc_frame_mode_previous
