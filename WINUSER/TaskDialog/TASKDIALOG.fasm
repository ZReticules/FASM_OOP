importlib Comctl32,\
	TaskDialogIndirect

importlib user32,\
	BeginPaint,\
	EndPaint,\
	GetParent

importlib shell32,\
	ShellExecuteW

TASKDIALOG.hasEvents = 0
TASKDIALOG.usedEvents = 0

macro TASKDIALOG.useEvents{
	TASKDIALOG.usedEvents = TASKDIALOG.hasEvents
}

TASKDIALOG.hasHooks = 0
TASKDIALOG.usedHooks = 0

macro TASKDIALOG.useHooks{
	TASKDIALOG.usedHooks = TASKDIALOG.hasHooks
}

