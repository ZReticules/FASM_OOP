macro @TASKDIALOG.enable_links {
	TDN.HYPERLINK_CLICKED tevent TASKDIALOG_linkClicked
} 

macro TASKDIALOG.clickPushButton this, btId{
	local _this
	inlineObj _this, this, pcx
	$call [SendMessageA]([_this + TASKDIALOG.hWnd], TDM.CLICK_BUTTON, btId, NULL)
}

macro TASKDIALOG.clickRadioButton this, btId{
	local _this
	inlineObj _this, this, pcx
	$call [SendMessageA]([_this + TASKDIALOG.hWnd], TDM.CLICK_RADIO_BUTTON, btId, NULL)
}

