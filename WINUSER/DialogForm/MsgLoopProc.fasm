importlib user32,\
	MapDialogRect;,\
	; SetWindowPtrA,\
	; GetWindowPtrA

importlib comctl32,\
	DefSubclassProc,\
	SetWindowSubclass

.proc_frame_mode_static

DLG.hasControls = 0
DLG.usedControls = 0

DLG.hasMainHooks = 0
DLG.usedMainHooks = 0

macro DLG.useControls{
	DLG.usedControls = DLG.hasControls 
}

macro DLG.useMainHooks{
	DLG.usedMainHooks = DLG.hasMainHooks 
}

.proc stdcall DLG.hookEventsChecker(.hWnd, .uMsg, .wParam, .lParam, .uIdSubclass, .dwRefData) uses psi pdi
	@sarg @arg1, @arg2, @arg3, @arg4
	$call DLG|getPtr(@arg1)
	; $call [GetWindowPtrA](@arg1, GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl CONTROL at psi from pax
	xor eax, eax
	mov pdi, [.cntrl.sData.lpHooks]
	cmp pdi, 0
		jz .default
	movzx ecx, word[pdi]
		jecxz .default
	add pdi, 2
	movzx edx, word[.uMsg]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .default
			$call std pointer[.cntrl + pdi]([.dwRefData], &.hWnd, &.cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.default:
	$call [DefSubclassProc]([.hWnd], [.uMsg], [.wParam], [.lParam])
	.return: ret
.endp

.proc cdecl DLG.controlNotifyChecker(.lpForm, .lParam) uses psi pdi pbx
	@sarg @arg1, @arg2
	virtObj .form DIALOGFORM at pbx from @arg1
	virtObj .nmhdr NMHDR at pdi from [.lParam]
	mov eax, dword[.nmhdr.idFrom]
	cmp eax, [.form.idCount]
		ja .return
	$call DLG|getPtr([.nmhdr.hwndFrom])
	; $call [GetWindowPtrA]([.nmhdr.hwndFrom], GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl CONTROL at psi from pax
	xor eax, eax
	mov pdx, [.cntrl.sData.lpNotifications]
	cmp pdx, 0
		jz .return
	movzx ecx, word[pdx]
		jecxz .return
	add pdx, 2
	mov eax, [.nmhdr.code]
	.find_notify:
		cmp ax, word[pdx + (pcx - 1) * 4]
		jne .not_my_notify
			; int3
			movzx pdi, word[pdx + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .return_zero
			$call std pointer[.cntrl + pdi](&.form, [.lParam], &.cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_notify:
	loop .find_notify
	.return_zero:
	xor eax, eax
	.return: ret
.endp

.proc cdecl DLG.controlEventsChecker(.lpForm, .wParam, .lpHwndDlg) uses psi pdi pbx
	@sarg @arg2, @arg3
	virtObj .form DIALOGFORM at pbx from @arg1
	movzx pdx, word[.wParam]
	; int3
	$call [GetDlgItem]([.form.hWnd], pdx)
	$call DLG|getPtr(pax)
	; $call [GetWindowPtrA](pax, GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl CONTROL at psi from pax
	xor eax, eax
	mov pdi, [.cntrl.sData.lpEvents]
	cmp pdi, 0
		jz .return
	movzx ecx, word[pdi]
		jecxz .return
	add pdi, 2
	movzx edx, word[.wParam + 2]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .return
			$call std pointer[.cntrl + pdi](&.form, [.lpHwndDlg], &.cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.return: ret
.endp

.proc cdecl DLG.hooksMainChecker(.hWnd, .uMsg, .wParam, .lParam, .uIdSubclass, .dwRefData) uses psi pdi
	@sarg @arg1, @arg2, @arg3, @arg4
	virtObj .form DIALOGFORM at psi from [.dwRefData]
	xor eax, eax
	mov pdi, [.form.sData.lpHooks]
	cmp pdi, 0
		jz .default
	movzx ecx, word[pdi]
		jecxz .default
	add pdi, 2
	movzx edx, word[.uMsg]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.form + pdi], 0
				jz .default
			$call std pointer[.form + pdi]([.dwRefData], &.hWnd, addr .form + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.default:
	$call [DefSubclassProc]([.hWnd], [.uMsg], [.wParam], [.lParam])
	.return: ret
.endp

.proc cdecl DLG.initEvent(.hwndDlg, .lParam) uses pbx psi pdi pbp
	@sarg @arg1, @arg2
	@larg pcx, @arg1
	virtObj .form DIALOGFORM at pbx from @arg2
	mov [.form.hWnd], pcx
	mov pbp, [.form.sData.lpClOffsets]
	$call DLG|setPtr([.hwndDlg], &.form)
    ; $call [OpenThemeData]([.form.hWnd], L "Menu;Button")
    ; mov [.form.hTheme], pax

    if DLG.hasMainHooks

	cmp [.form.sData.lpHooks], 0
	je .no_main_hook
		$call [SetWindowSubclass]([.form.hWnd], DLG.hooksMainChecker, -1, &.form)
	.no_main_hook:

	end if

	; with mapDialog:MapDialog([.form.hWnd])
	$call .form.sData.mapDialog::make([.form.hWnd])
	$call .form.sData.mapDialog::mapRect(&.form.sData.baseRect)
	
	if used DLG.hasControls
    
    cmp [.form.idCount], 0
    je .no_childs
		mov edi, [.form.idCount]
		.init_control_loop:
			mov psi, [pbp + (pdi - 1) * pointer.size]
			virtObj .cntrl CONTROL at psi from addr .form + psi 
			mov [.cntrl.ID], edi
			$call [GetDlgItem]([.form.hWnd], edi)
			mov [.cntrl.hWnd], pax
			$call DLG|setPtr([.cntrl.hWnd], &.cntrl)
			$call .form.sData.mapDialog::mapRect(&.cntrl.sData.baseRect)
			cmp [.cntrl.sData.lpHooks], NULL
			je .no_hook
				$call [SetWindowSubclass]([.cntrl.hWnd], DLG.hookEventsChecker, -1, &.form)
			.no_hook:
		dec pdi
		jnz .init_control_loop

		.local .sizesRect:RECT
		$call [GetClientRect]([.form.hWnd], &.sizesRect)
		$call CNV|fill(&.form.sData.defaultSize, &.sizesRect.right, sizeof.SIZE)
		$call .form::scaleChilds()
	.no_childs:

	end if
	
	.return: ret
.endp

.proc stdcall DLG.DialogProc(.hwndDlg, .uMsg, .wParam, .lParam) uses pdi pbx
	virtObj .form DIALOGFORM at pbx
	@sarg @arg1, @arg2, @arg3, @arg4
	mov eax, dword[.uMsg]
	cmp @arg2, WM_INITDIALOG
	je .init_event
		$call DLG|getPtr([.hwndDlg])
		; $call [GetWindowPtrA]([.hwndDlg], GWL_USERDATA)
		test pax, pax
			jz .return
		mov pbx, pax
	.after_init:
	xor eax, eax
	mov pdx, [.uMsg]
	mov ecx, dword[.wParam]

	if used DLG.hasControls
	
	cmp edx, WM_COMMAND
		je .commandEventsChecker
	cmp edx, WM_NOTIFY
		je .notificationsChecker
	
	end if


	; find form event
	mov pdi, [.form.sData.lpEvents]
	test pdi, pdi
		jz .after_event
	movzx ecx, word[pdi]
		jecxz .after_event
	add pdi, 2
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.form + pdi], 0
				jz .after_event
			$call std pointer[.form + pdi](&.form, &.hwndDlg, addr .form + pdi + pointer.size)
			jmp .after_event
		.not_my_event:
	loop .find_event
	.after_event:
	cmp [.uMsg], WM_CLOSE
		je .close_event
	; cmp [.uMsg], WM_DESTROY
	; 	je .destroy_event
	.return: ret

	.init_event:
		mov pbx, [.lParam]
		$call c DLG.initEvent([.hwndDlg], [.lParam])
		jmp .after_init

	if used DLG.hasControls

	.commandEventsChecker:
		cmp cx, word[.form.idCount]
			ja .return
		$call c DLG.controlEventsChecker(&.form, ecx, &.hwndDlg)
		jmp .return
	
	.notificationsChecker:
		$call c DLG.controlNotifyChecker(&.form, [.lParam])
		jmp .return

	end if
		
	.close_event:
		cmp pax, NULL
		cmove pax, [.wParam]
		$call [.form.__close](&.form, &.hwndDlg, pax)
		jmp .return
		
	; .destroy_event:
	; 	$call [EnumChildWindows]([.form.hWnd], .ptr_remove_callback, NULL)
	; 	$call DLG|removePtr([.form.hWnd])
	; 	$return 0

	; .proc stdcall .ptr_remove_callback(.hWnd, .lParam)
	; 	$call DLG|removePtr(@arg1)
	; 	$return esp
	; .endp
.endp

.proc_frame_mode_previous
