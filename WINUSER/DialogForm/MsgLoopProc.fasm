proc_noprologue

importlib user32,\
	SetWindowPtrA,\
	GetWindowPtrA,\
	MapDialogRect

importlib comctl32,\
	DefSubclassProc,\
	SetWindowSubclass

proc DLG.hookEventsChecker uses psi pdi, hWnd, uMsg, wParam, lParam, uIdSubclass, dwRefData
	@sarg @arg1, @arg2, @arg3, @arg4
	@call [GetWindowPtrA](@arg1, GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl:arg CONTROL at psi from pax
	xor eax, eax
	mov pdi, [.cntrl.sData.lpHooks]
	cmp pdi, 0
		jz .default
	movzx ecx, word[pdi]
		jecxz .default
	add pdi, 2
	movzx edx, word[uMsg]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .default
			@call std pointer[.cntrl + pdi]([dwRefData], addr hWnd, addr .cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.default:
	@call [DefSubclassProc]([hWnd], [uMsg], [wParam], [lParam])
	.return: ret
endp

proc DLG.controlNotifyChecker c uses psi pdi pbx, lpForm, lParam
	@sarg @arg1, @arg2
	virtObj .form:arg DIALOGFORM at pbx from @arg1
	virtObj .nmhdr NMHDR at pdi from [lParam]
	mov eax, dword[.nmhdr.idFrom]
	cmp eax, [.form.idCount]
		ja .return
	@call [GetWindowPtrA]([.nmhdr.hwndFrom], GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl:arg CONTROL at psi from pax
	xor eax, eax
	mov pdx, [.cntrl.sData.lpNotifications]
	cmp pdx, 0
		jz .return
	movzx ecx, word[pdx]
		jecxz .return
	add pdx, 2
	mov eax, [.nmhdr.code]
	.find_notify:
		cmp ax, word[pdx + (pcx - 1) * 4]
		jne .not_my_notify
			; int3
			movzx pdi, word[pdx + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .return_zero
			@call std pointer[.cntrl + pdi](addr .form, [lParam], addr .cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_notify:
	loop .find_notify
	.return_zero:
	xor eax, eax
	.return: ret
endp

proc DLG.controlEventsChecker c uses psi pdi pbx, lpForm, wParam, lpHwndDlg
	@sarg @arg2, @arg3
	virtObj .form:arg DIALOGFORM at pbx from @arg1
	movzx pdx, word[wParam]
	; int3
	@call [GetDlgItem]([.form.hWnd], pdx)
	@call [GetWindowPtrA](pax, GWL_USERDATA)
	test eax, eax
		jz .return
	virtObj .cntrl:arg CONTROL at psi from pax
	xor eax, eax
	mov pdi, [.cntrl.sData.lpEvents]
	cmp pdi, 0
		jz .return
	movzx ecx, word[pdi]
		jecxz .return
	add pdi, 2
	movzx edx, word[wParam + 2]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.cntrl + pdi], 0
				jz .return
			@call std pointer[.cntrl + pdi](addr .form, [lpHwndDlg], addr .cntrl, addr .cntrl + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.return: ret
endp

proc DLG.hooksMainChecker c uses psi pdi, hWnd, uMsg, wParam, lParam, uIdSubclass, dwRefData
	@sarg @arg1, @arg2, @arg3, @arg4
	virtObj .form:arg DIALOGFORM at psi from [dwRefData]
	xor eax, eax
	mov pdi, [.form.sData.lpHooks]
	cmp pdi, 0
		jz .default
	movzx ecx, word[pdi]
		jecxz .default
	add pdi, 2
	movzx edx, word[uMsg]
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.form + pdi], 0
				jz .default
			@call std pointer[.form + pdi]([dwRefData], addr hWnd, addr .form + pdi + pointer.size)
			jmp .return
		.not_my_event:
	loop .find_event
	.default:
	@call [DefSubclassProc]([hWnd], [uMsg], [wParam], [lParam])
	.return: ret
endp

proc DLG.initEvent c uses pbx psi pdi pbp, hwndDlg, lParam
	@sarg @arg1, @arg2
	@larg pcx, @arg1
	virtObj .form:arg DIALOGFORM at pbx from @arg2
	mov [.form.hWnd], pcx
	mov pbp, [.form.sData.lpClOffsets]
	@call [SetWindowPtrA]([hwndDlg], GWL_USERDATA, addr .form)
    ; @call [OpenThemeData]([.form.hWnd], L "Menu;Button")
    ; mov [.form.hTheme], pax

	cmp [.form.sData.lpHooks], 0
	je .no_main_hook
		@call [SetWindowSubclass]([.form.hWnd], DLG.hooksMainChecker, -1, addr .form)
	.no_main_hook:

	with mapDialog:MapDialog([.form.hWnd])
		@call mapDialog->mapRect(addr .form.sData.baseRect)
	    cmp [.form.idCount], 0
	    je .no_childs
			mov edi, [.form.idCount]
			.init_control_loop:
				mov psi, [pbp + (pdi - 1) * pointer.size]
				virtObj .cntrl:arg CONTROL at psi from addr .form + psi 
				mov [.cntrl.ID], edi
				@call [GetDlgItem]([.form.hWnd], edi)
				mov [.cntrl.hWnd], pax
				@call [SetWindowPtrA]([.cntrl.hWnd], GWL_USERDATA, addr .cntrl)
				@call mapDialog->mapRect(addr .cntrl.sData.baseRect)
				cmp [.cntrl.sData.lpHooks], NULL
				je .no_hook
					@call [SetWindowSubclass]([.cntrl.hWnd], DLG.hookEventsChecker, -1, addr .form)
				.no_hook:
			dec pdi
			jnz .init_control_loop
			@call .form->__scaleChildRects()
		.no_childs:
	end_with
	.return: ret
endp

proc DLG.DialogProc uses pdi pbx psi, hwndDlg, uMsg, wParam, lParam
	virtObj .form:arg DIALOGFORM at pbx
	@sarg @arg1, @arg2, @arg3, @arg4
	mov eax, dword[uMsg]
	cmp @arg2, WM_INITDIALOG
	je .init_event
		@call [GetWindowPtrA]([hwndDlg], GWL_USERDATA)
		test pax, pax
			jz .return
		mov pbx, pax
	.after_init:
	xor eax, eax
	mov pdx, [uMsg]
	mov ecx, dword[wParam]
	cmp edx, WM_COMMAND
		je .commandEventsChecker
	cmp edx, WM_NOTIFY
		je .notificationsChecker

	; find form event
	mov pdi, [.form.sData.lpEvents]
	test pdi, pdi
		jz .after_event
	movzx ecx, word[pdi]
		jecxz .after_event
	add pdi, 2
	.find_event:
		cmp dx, word[pdi + (pcx - 1) * 4]
		jne .not_my_event
			movzx pdi, word[pdi + (pcx - 1) * 4 + 2]
			cmp pointer[.form + pdi], 0
				jz .after_event
			mov psi, [.form + pdi]
			@call std pointer[.form + pdi](addr .form, addr hwndDlg, addr .form + pdi + pointer.size)
			jmp .after_event
		.not_my_event:
	loop .find_event
	.after_event:
	cmp [uMsg], WM_CLOSE
		je .close_event
	.return: ret

	.init_event:
		mov pbx, [lParam]
		@call c DLG.initEvent([hwndDlg], [lParam])
		jmp .after_init

	.commandEventsChecker:
		cmp cx, word[.form.idCount]
			ja .return
		@call c DLG.controlEventsChecker(addr .form, ecx, addr hwndDlg)
		jmp .return
	
	.notificationsChecker:
		@call c DLG.controlNotifyChecker(addr .form, [lParam])
		jmp .return
		
	.close_event:
	; int3
		cmp pax, NULL
			cmove pax, [wParam]
		@call [.form.__close](addr .form, addr hwndDlg, pax)
		jmp .return

endp

proc_resprologue
